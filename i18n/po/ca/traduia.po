msgstr ""
"  install           instal·la el conjunt de models estàndard (Marian) des de "
"la"

#: install-models-traduia:16
msgid "                    configured source (default: internet)"
msgstr "                    font configurada (per defecte: internet)"

#: install-models-traduia:17
msgid "  optimized         install the optimized (CTranslate2) model set"
msgstr ""
"  optimized         instal·la el conjunt de models optimitzat (CTranslate2)"

