#: install-models-traduia:12
msgid "Usage: install-models-traduia [options] [mode]"
msgstr "Uso: install-models-traduia [opciones] [modo]"

#: install-models-traduia:14
msgid "  (no parameters)  this help"
msgstr "  (sin parámetros)  esta ayuda"

#: install-models-traduia:15
msgid "  install           install the standard (Marian) model set from the"
msgstr ""
"  install           instala el set de modelos estándar (Marian) desde la"

#: install-models-traduia:16
msgid "                    configured source (default: internet)"
msgstr "                    fuente configurada (por defecto: internet)"

#: install-models-traduia:17
msgid "  optimized         install the optimized (CTranslate2) model set"
msgstr "  optimized         instala el set de modelos optimizado (CTranslate2)"

#: install-models-traduia:18
msgid "                    (experimental); combinable with \"install\""
msgstr "                    (experimental); combinable con \"install\""

#: install-models-traduia:19
msgid "  all               install both model sets (Marian and optimized/CT2)"
msgstr ""
"  all               instala los dos sets de modelos (Marian y optimized/CT2)"

#: install-models-traduia:20
msgid "                    in the same run; Marian takes priority; combinable"
msgstr ""
"                    en la misma ejecución; Marian tiene prioridad; combinable"

#: install-models-traduia:21
msgid "                    with \"install\" and \"optimized\""
msgstr "                    con \"install\" y \"optimized\""

#: install-models-traduia:22
msgid "  --url <url>       repository base URL (contains manifest.json)"
msgstr "  --url <url>       URL base del repositorio (contiene manifest.json)"

#: install-models-traduia:23
msgid "  --dir <path>      local repository directory (USB, mounted drive)"
msgstr ""
"  --dir <ruta>      directorio de repositorio local (USB, unidad montada)"

#: install-models-traduia:24
msgid "  --from <url|path> auto-detect: URL or local path"
msgstr "  --from <url|ruta> autodetección: URL o ruta local"

#: install-models-traduia:25
msgid "  --detect          print model set state (complete:* / partial / none)"
msgstr ""
"  --detect          imprime el estado del set (complete:* / partial / none)"

#: install-models-traduia:26
msgid "  help, --help, -h  this help"
msgstr "  help, --help, -h  esta ayuda"

