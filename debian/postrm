#!/bin/sh
# postrm script for traduia.
#
# See: dh_installdeb(1).

set -e

# Summary of how this script can be called:
#        * <postrm> 'remove'
#        * <postrm> 'purge'
#        * <old-postrm> 'upgrade' <new-version>
#        * <new-postrm> 'failed-upgrade' <old-version>
#        * <new-postrm> 'abort-install'
#        * <new-postrm> 'abort-install' <old-version>
#        * <new-postrm> 'abort-upgrade' <old-version>
#        * <disappearer's-postrm> 'disappear' <overwriter>
#          <overwriter-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.


# Borra solo si la ruta real coincide exactamente con la esperada: evita
# que variables vacías o manipuladas escapen de las rutas fijadas.
safe_rm_exact() {
    _safe_expected="$1"
    _safe_path="$2"
    [ -n "$_safe_expected" ] && [ -n "$_safe_path" ] || return 1
    _safe_real_expected="$(realpath -m -- "$_safe_expected" 2>/dev/null)" || return 1
    _safe_real_path="$(realpath -m -- "$_safe_path" 2>/dev/null)" || return 1
    [ -n "$_safe_real_expected" ] && [ -n "$_safe_real_path" ] || return 1
    [ "$_safe_real_expected" = "$_safe_real_path" ] || return 1
    rm -rf -- "$_safe_path"
}

case "$1" in
    purge)
        models='/opt/ai/traduia/models'
        if [ -e "$models" ]; then
            safe_rm_exact '/opt/ai/traduia/models' "$models" || true
        fi
        venv='/opt/ai/traduia/venv'
        if [ -e "$venv" ]; then
            safe_rm_exact '/opt/ai/traduia/venv' "$venv" || true
        fi
        mode_flag='/opt/ai/traduia/.mode'
        if [ -e "$mode_flag" ]; then
            safe_rm_exact '/opt/ai/traduia/.mode' "$mode_flag" || true
        fi
        d='/usr/lib/traduia'
        if [ -d "$d" ] && [ "$(realpath -m -- "$d")" = "/usr/lib/traduia" ]; then
            rmdir -- "$d" || true
        fi
        # Paths antiguos (por si quedaron de una migración incompleta)
        old_models='/usr/lib/ai/traduia_models'
        if [ -e "$old_models" ]; then
            safe_rm_exact '/usr/lib/ai/traduia_models' "$old_models" || true
        fi
        old_venv='/usr/lib/traduia/venv'
        if [ -e "$old_venv" ]; then
            safe_rm_exact '/usr/lib/traduia/venv' "$old_venv" || true
        fi
    ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
