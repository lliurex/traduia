#!/usr/bin/env python3
import socket
import sys
import urllib.request
import json

def get_local_ips():
    ips = set(['127.0.0.1', '::1'])
    try:
        # Get all interfaces info
        for info in socket.getaddrinfo(socket.gethostname(), None):
            ips.add(info[4][0])
    except:
        pass

    # Another way to get common local IP
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ips.add(s.getsockname()[0])
        s.close()
    except:
        pass
    return ips

def is_port_open(host, port, timeout=2):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except:
        return False

def check_json_4141(host, timeout=2):
    url = f"http://{host}:4141"
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            content_type = response.headers.get('Content-Type', '')
            if 'application/json' in content_type:
                return True
            # Fallback check if it's valid JSON even without header
            data = response.read().decode('utf-8')
            json.loads(data)
            return True
    except:
        return False

def main():
    target_host = "server"
    local_ips = get_local_ips()
    
    try:
        remote_ip = socket.gethostbyname(target_host)
        is_resolvable = True
    except socket.gaierror:
        is_resolvable = False
        remote_ip = None

    if is_resolvable and remote_ip not in local_ips:
        if is_port_open(target_host, 8000):
            if is_port_open(target_host, 4141) and check_json_4141(target_host):
                sys.stdout.write(f"http://{target_host}:8000\n")
                sys.stderr.write(f"{target_host}+http\n")
            else:
                sys.stdout.write(f"https://{target_host}:8000\n")
                sys.stderr.write(f"{target_host}\n")
            return

    sys.stdout.write("http://localhost:8000\n")
    sys.stderr.write("local\n")

if __name__ == "__main__":
    main()
