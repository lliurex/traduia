#!/usr/bin/env python3
import socket
import sys
import os

# Puerto de la aplicación (constante estática; override por env para pruebas).
APP_PORT = int(os.environ.get("TRADUIA_APP_PORT", "8000"))
# Hostname del servidor de aula (override por env para pruebas).
SERVER_HOST = os.environ.get("TRADUIA_SERVER_HOST", "server")

DEFAULT_HOST = "/usr/share/doc/traduia/not-available.html"


def is_port_open(host, port, timeout=2):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except:
        return False


def main():
    # Detect system language
    sys_lang = os.environ.get("LANG", "en").split("_")[0].split(".")[0].split("-")[0].lower()

    # Orden de intentos: primero el host "server" (si existe), luego localhost.
    candidates = []
    try:
        socket.gethostbyname(SERVER_HOST)
        candidates.append(SERVER_HOST)
    except socket.gaierror:
        pass
    candidates.append("localhost")

    for host in candidates:
        if is_port_open(host, APP_PORT):
            url = f"http://{host}:{APP_PORT}"
            codename = "remote" if host == SERVER_HOST else "local"
            sys.stdout.write(f"{url}\n")
            sys.stderr.write(f"{codename}\n")
            return

    # Ningún servidor activo: página estática local.
    url = f"file://{DEFAULT_HOST}#lang={sys_lang}"
    sys.stdout.write(f"{url}\n")
    sys.stderr.write("not-available\n")


if __name__ == "__main__":
    main()
