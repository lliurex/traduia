# >>> SAFE RM (begin)
# Borrados confinados a un basedir. safe_within resuelve symlinks con
# realpath -m y exige que el destino quede estrictamente dentro del base.
safe_within() {
    local base="$1" path="$2" real_base real_path
    [ -n "$base" ] && [ -n "$path" ] || return 1
    real_base="$(realpath -m -- "$base" 2>/dev/null)" || return 1
    real_path="$(realpath -m -- "$path" 2>/dev/null)" || return 1
    [ -n "$real_base" ] && [ -n "$real_path" ] || return 1
    [ "$real_base" != "/" ] || return 1
    [ "$real_path" != "/" ] || return 1
    [ "$real_path" != "$real_base" ] || return 1
    case "$real_path" in
        "$real_base"/*) return 0 ;;
        *) return 1 ;;
    esac
}

safe_within_or_equal() {
    local base="$1" path="$2" real_base real_path
    [ -n "$base" ] && [ -n "$path" ] || return 1
    real_base="$(realpath -m -- "$base" 2>/dev/null)" || return 1
    real_path="$(realpath -m -- "$path" 2>/dev/null)" || return 1
    [ -n "$real_base" ] && [ -n "$real_path" ] || return 1
    [ "$real_base" != "/" ] || return 1
    [ "$real_path" != "/" ] || return 1
    case "$real_path" in
        "$real_base"|"$real_base"/*) return 0 ;;
        *) return 1 ;;
    esac
}

safe_rm_rf() {
    [ $# -ge 1 ] || return 1
    local base="$1"; shift
    local p
    [ $# -gt 0 ] || return 1
    for p in "$@"; do
        if safe_within "$base" "$p"; then
            rm -rf -- "$p"
        else
            echo "[ERROR] Refusing to remove outside base: $p (base: $base)" >&2
            return 1
        fi
    done
}

safe_rm_f() {
    [ $# -ge 1 ] || return 1
    local base="$1"; shift
    local p
    [ $# -gt 0 ] || return 1
    for p in "$@"; do
        if safe_within "$base" "$p"; then
            rm -f -- "$p"
        else
            echo "[ERROR] Refusing to remove outside base: $p (base: $base)" >&2
            return 1
        fi
    done
}

safe_find_cache() {
    local base="$1" dir="$2"
    if ! safe_within_or_equal "$base" "$dir"; then
        echo "[ERROR] Refusing to clean outside base: $dir (base: $base)" >&2
        return 1
    fi
    find -P "$dir" -depth -type d -name .cache -exec rm -rf -- {} +
}
# <<< SAFE RM (end)

# >>> SAFE OUT DIR (begin)
# Directorios de sistema: se rechazan por coincidencia exacta.
SYSTEM_DIRS_EXACT="/ /usr /etc /var /home /root /opt /boot /dev /proc /sys /bin /sbin /lib /lib32 /lib64 /run /tmp /srv /media /mnt"
# Árboles protegidos: se rechaza cualquier ruta DENTRO de ellos (p.ej. /usr/bin).
# Los destinos de datos (/opt/*, /srv/*, /media/*, /mnt/*, /tmp/*) sí se permiten.
SYSTEM_DIRS_TREES="/usr /etc /boot /var /run /root /home /proc /sys /dev /bin /sbin /lib /lib32 /lib64"

is_denied_out_dir() {
    local p="${1%/}" t
    [ -n "$p" ] || p="/"
    for t in $SYSTEM_DIRS_EXACT; do
        [ "$p" = "$t" ] && return 0
    done
    for t in $SYSTEM_DIRS_TREES; do
        case "$p" in
            "$t"/*) return 0 ;;
        esac
    done
    return 1
}

set_out_dir() {
    local raw="$1" real
    [ -n "$raw" ] || { echo "[ERROR] Empty output directory." >&2; exit 1; }
    case "$raw" in
        /*) ;;
        *) echo "[ERROR] Output directory must be an absolute path: $raw" >&2; exit 1 ;;
    esac
    real="$(realpath -m -- "$raw" 2>/dev/null)" || { echo "[ERROR] Invalid output directory: $raw" >&2; exit 1; }
    [ -n "$real" ] && [ "$real" != "/" ] || { echo "[ERROR] Refusing to use / as output directory." >&2; exit 1; }
    if is_denied_out_dir "$real"; then
        echo "[ERROR] Refusing to use system directory as output: $real" >&2
        exit 1
    fi
    OUT_DIR="$real"
}
