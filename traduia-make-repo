}

# =========================================================
# generate_manifest <out_dir>: (re)genera manifest.json con
# tamaño+sha256 de todo el árbol (sets, wheels, verify-models.py).
# =========================================================
generate_manifest() {
    local out_dir="$1"
    echo "$(_ "Hashing files (sha256)...")"
    python3 - "$out_dir" <<'PY'
import hashlib
import json
import os
import sys
from datetime import datetime, timezone

out_dir = sys.argv[1]


def _has_set(sub):
    sub_dir = os.path.join(out_dir, sub)
    if not os.path.isdir(sub_dir):
        return False
    return any(os.path.isdir(os.path.join(sub_dir, d)) for d in os.listdir(sub_dir))


ct2_set = _has_set("ct2")
marian_set = _has_set("marian")
if ct2_set and marian_set:
    mode = "both"
elif ct2_set:
    mode = "ct2"
elif marian_set:
    mode = "marian"
else:
    mode = "none"

files = []
for root, dirs, fnames in os.walk(out_dir):
    # Excluir .cache (artefactos de HuggingFace)
    dirs[:] = [d for d in dirs if d != ".cache"]
    dirs.sort()
    for fname in sorted(fnames):
        if fname.endswith(".h5"):
            continue
        abs_path = os.path.join(root, fname)
        rel_path = os.path.relpath(abs_path, out_dir)
        if rel_path == "manifest.json":
            continue
        size = os.path.getsize(abs_path)
        sha = hashlib.sha256()
        with open(abs_path, "rb") as fh:
            for chunk in iter(lambda: fh.read(1024 * 1024), b""):
                sha.update(chunk)
        files.append({"path": rel_path, "size": size, "sha256": sha.hexdigest()})
        print(f"[hash] {rel_path} ({size} bytes)")

manifest = {
    "version": 1,
    "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "mode": mode,
    "files": files,
}

with open(os.path.join(out_dir, "manifest.json"), "w", encoding="utf-8") as fh:
    json.dump(manifest, fh, indent=2, ensure_ascii=False)
    fh.write("\n")

print(f"[ok] manifest.json written with {len(files)} files (mode={mode})")
PY
}

# =========================================================
# write_verify_script <out_dir>: escribe (o refresca) junto al
# manifest el verificador de integridad verify-models.py, para
# que el repositorio lo lleve siempre consigo. Se invoca desde
# todos los subcomandos que generan manifest (local, fetch,
# wheels y debs); es idempotente.
# =========================================================
write_verify_script() {
    local out_dir="$1"
    cat > "$out_dir/verify-models.py" <<'PY'
#!/usr/bin/env python3
"""Verifica la integridad del repositorio contra manifest.json.

Uso: python3 verify-models.py [--mode ct2|marian] [directorio]
     (directorio por defecto: el actual; --mode verifica solo whisper + un set)
"""
import hashlib
import json
import os
import sys


def parse_args(argv):
    mode = None
    repo = "."
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--mode":
            i += 1
            if i >= len(argv):
                print("ERROR: --mode requires 'ct2' or 'marian'.", file=sys.stderr)
                sys.exit(2)
            mode = argv[i]
        elif a.startswith("--mode="):
            mode = a.split("=", 1)[1]
        else:
            repo = a
        i += 1
    if mode not in (None, "ct2", "marian"):
        print(f"ERROR: unknown mode: {mode}", file=sys.stderr)
        sys.exit(2)
    return repo, mode


def wanted(rel, mode):
    if mode is None:
        return True
    return rel.startswith("whisper-small/") or rel.startswith(f"{mode}/")


def main():
    repo, mode = parse_args(sys.argv[1:])
    manifest_path = os.path.join(repo, "manifest.json")

    try:
        with open(manifest_path, encoding="utf-8") as fh:
            manifest = json.load(fh)
    except (json.JSONDecodeError, OSError) as e:
        print(f"ERROR: no se pudo leer {manifest_path}: {e}", file=sys.stderr)
        sys.exit(1)

    files = manifest.get("files", [])
    if not files:
        print("ERROR: manifest.json no contiene ficheros.", file=sys.stderr)
        sys.exit(1)

    if mode is not None and not any(e["path"].startswith(f"{mode}/") for e in files):
        print(f"ERROR: no hay entradas del modo '{mode}' en el manifest.", file=sys.stderr)
        sys.exit(1)

    errors = 0
    for entry in files:
        rel = entry["path"]
        if not wanted(rel, mode):
            continue
        p = os.path.join(repo, rel)
        try:
            if not os.path.exists(p) or os.path.getsize(p) != entry.get("size"):
                print("FALTA/TAMAÑO:", rel)
                errors += 1
                continue
            sha = entry.get("sha256")
            if not sha:
                print("OK:", rel)
                continue
            h = hashlib.sha256()
            with open(p, "rb") as fh:
                for chunk in iter(lambda: fh.read(1024 * 1024), b""):
                    h.update(chunk)
            if h.hexdigest() != sha:
                print("SHA256 INCORRECTO:", rel)
                errors += 1
            else:
                print("OK:", rel)
        except OSError as e:
            print(f"ERROR NO LEGIBLE: {rel} ({e})")
            errors += 1

    print("OK" if errors == 0 else f"{errors} errores")
    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
PY
    chmod +x "$out_dir/verify-models.py"
}

# =========================================================
# make_wheels <out_dir>: descarga el árbol completo de wheels
# de las dependencias Python (deps transitivas incluidas) para
# jammy (cp310) y noble (cp312), amd64. pip download resuelve
# el árbol; torch CPU se toma de su índice exclusivo (incluye
# sus dependencias). Todo como wheels (--only-binary=:all:),
# de modo que la instalación offline no necesita compiladores.
# =========================================================
WHEELS_PLATFORMS=(manylinux2014_x86_64 manylinux_2_17_x86_64 manylinux_2_28_x86_64 linux_x86_64)
WHEELS_PKGS=(pip setuptools wheel fastapi "uvicorn[standard]" python-multipart numpy sounddevice faster-whisper transformers sentencepiece huggingface_hub ctranslate2 psutil sacremoses exceptiongroup)

make_wheels() {
    local out_dir="$1"
    local wheels_dir="$out_dir/wheels"
    local log_file
    local targets=("3.10:jammy:cp310" "3.12:noble:cp312")
    local t pyver label abi
    local p
    local pflags=()

    mkdir -p "$wheels_dir"

    log_file="$(mktemp)"

    cleanup_wheels_log() {
        rm -f "$log_file"
    }
    trap cleanup_wheels_log RETURN

    for p in "${WHEELS_PLATFORMS[@]}"; do
        pflags+=(--platform "$p")
    done

    for t in "${targets[@]}"; do
        pyver="${t%%:*}"
        label="$(echo "$t" | cut -d: -f2)"
        abi="${t##*:}"

        echo "[wheels] $(_ "Downloading wheels for:") $label (python $pyver)"

        : > "$log_file"

        if ! python3 -m pip download \
            --dest "$wheels_dir" \
            --only-binary=:all: \
            --python-version "$pyver" \
            --implementation cp \
            --abi "$abi" \
            --abi abi3 \
            --abi none \
            "${pflags[@]}" \
            "${WHEELS_PKGS[@]}" \
            >"$log_file" 2>&1
        then
            echo "[ERROR] $(_ "Error downloading wheels for target:") $label" >&2
            echo "[ERROR] $(_ "pip output:")" >&2
            tail -n 60 "$log_file" >&2
            exit 1
        fi

        : > "$log_file"

        # torch CPU desde su índice exclusivo.
        if ! python3 -m pip download \
            --dest "$wheels_dir" \
            --only-binary=:all: \
            --python-version "$pyver" \
            --implementation cp \
            --abi "$abi" \
            --abi abi3 \
            --abi none \
            "${pflags[@]}" \
            --index-url https://download.pytorch.org/whl/cpu \
            torch \
            >"$log_file" 2>&1
        then
            echo "[ERROR] $(_ "Error downloading wheels for target:") $label (torch)" >&2
            echo "[ERROR] $(_ "pip output:")" >&2
            tail -n 60 "$log_file" >&2
            exit 1
        fi
    done

    # Regresión conocida: Python 3.10 necesita exceptiongroup a través de anyio.
    if ! compgen -G "$wheels_dir/exceptiongroup-*.whl" >/dev/null; then
        echo "[ERROR] $(_ "The Python 3.10 wheels repository is incomplete: exceptiongroup wheel is missing.")" >&2
        exit 1
    fi

    echo "[wheels] $(_ "Wheels ready in:") $wheels_dir"
}

SCRIPT_NAME="$(basename "$0")"

