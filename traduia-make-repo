# =========================================================
# make_wheels <out_dir>: descarga el árbol completo de wheels
# de las dependencias Python (deps transitivas incluidas) para
# jammy (cp310) y noble (cp312), amd64. pip download resuelve
# el árbol; torch CPU se toma de su índice exclusivo (incluye
# sus dependencias). Todo como wheels (--only-binary=:all:),
# de modo que la instalación offline no necesita compiladores.
# =========================================================
WHEELS_PLATFORMS=(manylinux2014_x86_64 manylinux_2_17_x86_64 manylinux_2_28_x86_64 linux_x86_64)
# faster-whisper/ctranslate2 con versión fijada: deben coincidir con
# BASE_PYTHON_PKGS de install-models-traduia (instalaciones reproducibles).
WHEELS_PKGS=(pip setuptools wheel fastapi "uvicorn[standard]" python-multipart numpy sounddevice "faster-whisper==1.2.1" "ctranslate2==4.8.2" transformers sentencepiece huggingface_hub psutil sacremoses exceptiongroup)

make_wheels() {
    local out_dir="$1"
    local wheels_dir="$out_dir/wheels"
    local log_file
    local targets=("3.10:jammy:cp310" "3.12:noble:cp312")
    local t pyver label abi
    local p
    local pflags=()

    # Misma guarda que debs/: no se escribe fuera del directorio de salida.
    if ! safe_within_or_equal "$OUT_DIR" "$wheels_dir"; then
        echo "[ERROR] $(_ "Refusing to write outside output directory:") $wheels_dir" >&2
        return 1
    fi
    mkdir -p "$wheels_dir"

    log_file="$(mktemp)"

    cleanup_wheels_log() {
        safe_rm_f "$TMP_BASE" "$log_file" || true
    }
    trap cleanup_wheels_log RETURN

    for p in "${WHEELS_PLATFORMS[@]}"; do
        pflags+=(--platform "$p")
    done

    for t in "${targets[@]}"; do
        pyver="${t%%:*}"
        label="$(echo "$t" | cut -d: -f2)"
        abi="${t##*:}"

        echo "[wheels] $(_ "Downloading wheels for:") $label (python $pyver)"

        : > "$log_file"

        if ! python3 -m pip download \
            --dest "$wheels_dir" \
            --only-binary=:all: \
            --python-version "$pyver" \
            --implementation cp \
            --abi "$abi" \
            --abi abi3 \
            --abi none \
            "${pflags[@]}" \
            "${WHEELS_PKGS[@]}" \
            >"$log_file" 2>&1
        then
            echo "[ERROR] $(_ "Error downloading wheels for target:") $label" >&2
            echo "[ERROR] $(_ "pip output:")" >&2
            tail -n 60 "$log_file" >&2
            return 1
        fi

        : > "$log_file"

        # torch CPU desde su índice exclusivo.
        if ! python3 -m pip download \
            --dest "$wheels_dir" \
            --only-binary=:all: \
            --python-version "$pyver" \
            --implementation cp \
            --abi "$abi" \
            --abi abi3 \
            --abi none \
            "${pflags[@]}" \
            --index-url https://download.pytorch.org/whl/cpu \
            torch \
            >"$log_file" 2>&1
        then
            echo "[ERROR] $(_ "Error downloading wheels for target:") $label (torch)" >&2
            echo "[ERROR] $(_ "pip output:")" >&2
            tail -n 60 "$log_file" >&2
            return 1
        fi
    done

    # Regresión conocida: Python 3.10 necesita exceptiongroup a través de anyio.
    if ! compgen -G "$wheels_dir/exceptiongroup-*.whl" >/dev/null; then
        echo "[ERROR] $(_ "The Python 3.10 wheels repository is incomplete: exceptiongroup wheel is missing.")" >&2
        return 1
    fi

    # Comprobación de completitud por target: si falta algún wheel para
    # un ABI (p. ej. cp312), la instalación offline fallaría con
    # "from versions: none". Se detecta aquí, en el build.
    for t in "${targets[@]}"; do
        abi="${t##*:}"
        missing=()
        for pkg in numpy torch ctranslate2; do
            if ! compgen -G "$wheels_dir/${pkg}-*${abi}*.whl" >/dev/null; then
                missing+=("$pkg")
            fi
        done
        for pkg in pip setuptools wheel faster_whisper; do
            if ! compgen -G "$wheels_dir/${pkg}-*py3-none-any*.whl" >/dev/null; then
                missing+=("$pkg")
            fi
        done
        if [ "${#missing[@]}" -gt 0 ]; then
            echo "[ERROR] The wheels repository is incomplete for target $abi. Missing: ${missing[*]}" >&2
            echo "[ERROR] Re-run 'traduia-make-repo --wheels --output-dir <dir>' to complete it." >&2
            return 1
        fi
    done

    echo "[wheels] $(_ "Wheels ready in:") $wheels_dir"
}

