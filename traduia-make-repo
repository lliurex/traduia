# --- Subcomando: traduia-make-repo debs <output_dir> ---
# Descarga los paquetes .deb del sistema (traduia, zero-lliurex-traduia)
# con apt-get download y los copia a <out>/debs/ para permitir la
# instalación del paquete y de traduia-config en equipos totalmente
# offline. apt-get download no trae dependencias: estas deben estar
# disponibles en el equipo destino (caché apt, repos del aula o medios).
# Aditivo: se puede ejecutar sobre un directorio de repositorio ya generado.
DEBS_PKGS=(traduia zero-lliurex-traduia)

# =========================================================
# make_debs <out_dir> <distro> <base_url>: descarga los paquetes
# del sistema (traduia, zero-lliurex-traduia) de una distribución
# (jammy|noble) leyendo los índices apt del repositorio por HTTP
# (python3 stdlib; no usa apt, así que es independiente de la
# distribución de la máquina que ejecuta el comando). Recorre las
# suites <s>, <s>-updates y <s>-security (las ausentes se omiten),
# elige la versión mayor y verifica el sha256 contra el índice.
# Los debs quedan en <out>/debs/<distro>/ (refresco aditivo por
# distro: solo se vacía el subdirectorio de la distro pedida).
# =========================================================
make_debs() {
    local out_dir="$1"
    local distro="$2"
    local base_url="${3%/}"
    local debs_dir="$out_dir/debs/$distro"
    mkdir -p "$debs_dir"
    echo "[debs] $(_ "Downloading system packages for:") $distro ($base_url)"
    local rc=0
    python3 - "$distro" "$base_url" "$debs_dir" "${DEBS_PKGS[@]}" <<'PY' || rc=$?
import gzip
import hashlib
import os
import re
import sys
import urllib.request

distro = sys.argv[1]
base_url = sys.argv[2].rstrip("/")
debs_dir = sys.argv[3]
packages = sys.argv[4:]


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "traduia-make-repo"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        return resp.read()


def fetch_optional(url):
    """Descarga la URL; devuelve None si no existe (404 / no encontrado)."""
    try:
        return fetch(url)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise
    except FileNotFoundError:
        return None
    except urllib.error.URLError as e:
        reason = getattr(e, "reason", None)
        if isinstance(reason, FileNotFoundError) or getattr(reason, "errno", None) == 2:
            return None
        raise


def version_key(v):
    # Comparación simple estilo dpkg: segmentos numéricos y alfanuméricos
    key = []
    for part in re.split(r"[.~+:-]", v):
        if part.isdigit():
            key.append((1, int(part), ""))
        else:
            key.append((0, 0, part))
    return key


best = {}
for suite in (distro, f"{distro}-updates", f"{distro}-security"):
    idx_url = f"{base_url}/dists/{suite}/main/binary-amd64/Packages.gz"
    try:
        raw = fetch_optional(idx_url)
    except Exception as e:
        print(f"[ERROR] Could not fetch the Packages index from: {idx_url} ({e})", file=sys.stderr)
        sys.exit(1)
    if raw is None:
        print(f"[debs] Suite not available, skipping: {suite}")
        continue
    try:
        text = gzip.decompress(raw).decode("utf-8", "replace")
    except Exception as e:
        print(f"[ERROR] Could not parse the Packages index: {idx_url} ({e})", file=sys.stderr)
        sys.exit(1)

    stanza = {}
    for line in text.splitlines() + [""]:
        if line.strip() == "":
            pkg = stanza.get("Package")
            if pkg in packages:
                ver = stanza.get("Version", "")
                cand = version_key(ver)
                if pkg not in best or cand > best[pkg]["key"]:
                    best[pkg] = {
                        "key": cand,
                        "version": ver,
                        "filename": stanza.get("Filename", ""),
                        "sha256": stanza.get("SHA256", ""),
                        "size": stanza.get("Size", ""),
                    }
            stanza = {}
            continue
        if ":" in line:
            field, _, value = line.partition(":")
            stanza[field.strip()] = value.strip()
        elif line.startswith((" ", "\t")) and stanza:
            last = list(stanza)[-1]
            stanza[last] += " " + line.strip()

if not best:
    print("[ERROR] None of the packages were found in the repository indexes.", file=sys.stderr)
    sys.exit(1)

# Refresco aditivo: solo se vacía el subdirectorio de esta distro
for name in os.listdir(debs_dir):
    if name.endswith(".deb"):
        os.remove(os.path.join(debs_dir, name))

failed = False
for pkg in packages:
    if pkg not in best:
        print(f"[ERROR] Package not found in the repository indexes: {pkg}", file=sys.stderr)
        failed = True
        continue
    info = best[pkg]
    deb_url = f"{base_url}/{info['filename']}"
    dest = os.path.join(debs_dir, os.path.basename(info["filename"]))
    print(f"[debs] Downloading {pkg} {info['version']} -> {dest}")
    try:
        data = fetch(deb_url)
    except Exception as e:
        print(f"[ERROR] Could not download: {deb_url} ({e})", file=sys.stderr)
        failed = True
        continue
    if info["size"] and str(len(data)) != info["size"]:
        print(f"[ERROR] Size mismatch for: {pkg}", file=sys.stderr)
        failed = True
        continue
    if info["sha256"]:
        digest = hashlib.sha256(data).hexdigest()
        if digest != info["sha256"]:
            print(f"[ERROR] SHA256 mismatch for: {pkg}", file=sys.stderr)
            failed = True
            continue
    with open(dest, "wb") as fh:
        fh.write(data)

sys.exit(1 if failed else 0)
PY
    if [ "$rc" -ne 0 ]; then
        return 1
    fi
    printf '[debs] %s\n' "$(_ "Packages ready in:") $debs_dir"
}

# =========================================================
# fetch_inet_models <ct2|marian|all> <out_dir>: descarga los
# modelos directamente de HuggingFace (aditivo, par a par).
# whisper-small desde mijuanlo (fallback Systran); marian desde
# mijuanlo (fallback Helsinki-NLP); ct2 desde mijuanlo
# pre-convertido (sin conversión local). Con 'all' se descargan
# ambos sets, marian primero. Los pares ya completos se omiten.
# =========================================================
fetch_inet_models() {
    local mode="$1"
    local out_dir="${2%/}"
    local rc=0
    echo "[fetch] $(_ "Downloading models from HuggingFace...")"
    python3 - "$mode" "$out_dir" <<'PY' || rc=$?
import os
import sys
from huggingface_hub import snapshot_download, model_info
from huggingface_hub.utils import disable_progress_bars, RepositoryNotFoundError

disable_progress_bars()

mode, out = sys.argv[1], sys.argv[2]

PAIRS = [
    "es-en", "es-fr", "es-de", "es-ru", "es-ar",
    "es-uk", "es-ro", "es-it", "ca-en", "ca-es",
]

failed_ct2 = []


def _has(path, fname):
    f = os.path.join(out, path, fname)
    return os.path.isfile(f) and os.path.getsize(f) > 0


def _download(repo, dest):
    print(f"[fetch] Downloading {repo} -> {dest}")
    snapshot_download(repo_id=repo, local_dir=dest)


# whisper-small (aditivo: solo si el directorio está vacío)
wdir = os.path.join(out, "whisper-small")
if os.path.isdir(wdir) and os.listdir(wdir):
    print("[fetch] whisper-small already present, skipping.")
else:
    os.makedirs(wdir, exist_ok=True)
    try:
        model_info("mijuanlo/whisper-small-ct2-int8")
        _download("mijuanlo/whisper-small-ct2-int8", wdir)
    except (RepositoryNotFoundError, Exception):
        print("[fetch] mijuanlo whisper not available, fallback to: Systran/faster-whisper-small")
        _download("Systran/faster-whisper-small", wdir)

want_marian = mode in ("marian", "all")
want_ct2 = mode in ("ct2", "all")

for pair in PAIRS:
    if want_marian:
        rel = os.path.join("marian", f"opus-mt-{pair}")
        if _has(rel, "pytorch_model.bin"):
            print(f"[fetch] {rel} already present, skipping.")
        else:
            os.makedirs(os.path.join(out, rel), exist_ok=True)
            try:
                model_info(f"mijuanlo/opus-mt-{pair}")
                _download(f"mijuanlo/opus-mt-{pair}", os.path.join(out, rel))
            except (RepositoryNotFoundError, Exception):
                print(f"[fetch] mijuanlo/opus-mt-{pair} not available, fallback to: Helsinki-NLP/opus-mt-{pair}")
                _download(f"Helsinki-NLP/opus-mt-{pair}", os.path.join(out, rel))
    if want_ct2:
        rel = os.path.join("ct2", f"opus-mt-{pair}")
        if _has(rel, "model.bin"):
            print(f"[fetch] {rel} already present, skipping.")
        else:
            os.makedirs(os.path.join(out, rel), exist_ok=True)
            try:
                model_info(f"mijuanlo/opus-mt-{pair}-ct2-int8")
                _download(f"mijuanlo/opus-mt-{pair}-ct2-int8", os.path.join(out, rel))
            except (RepositoryNotFoundError, Exception):
                print(f"[ERROR] Pre-converted CT2 model not available for: {pair}", file=sys.stderr)
                failed_ct2.append(pair)

if failed_ct2:
    print(f"[ERROR] CT2 pairs not available: {', '.join(failed_ct2)}", file=sys.stderr)
    sys.exit(1)
PY
    echo "[fetch] $(_ "Fetch finished.")"
    return "$rc"
}

# --- Subcomando: traduia-make-repo fetch <ct2|marian|all> <output_dir> ---
# Descarga los modelos directamente de HuggingFace. Aditivo: se puede
# ejecutar una vez por set (o con 'all') sobre un directorio ya generado.
# Si algún par ct2 pre-convertido no está disponible, el manifest se
# regenera igualmente (re-ejecutar reintenta lo faltante) y se sale con 1.
if [ "${POSITIONAL[0]:-}" = "fetch" ]; then
    if [ "${#POSITIONAL[@]}" -ne 3 ]; then
        usage
        exit 1
    fi
    FETCH_MODE="${POSITIONAL[1]}"
    if [ "$FETCH_MODE" != "ct2" ] && [ "$FETCH_MODE" != "marian" ] && [ "$FETCH_MODE" != "all" ]; then
        echo "$(_ "Error: mode must be 'ct2', 'marian' or 'all'.")" >&2
        exit 1
    fi
    OUT_DIR="${POSITIONAL[2]}"
    if ! python3 -c "import huggingface_hub" >/dev/null 2>&1; then
        echo "[ERROR] $(_ "This command requires the 'huggingface_hub' Python package (pip install huggingface_hub).")" >&2
        exit 1
    fi
    mkdir -p "$OUT_DIR"
    FETCH_INCOMPLETE=false
    fetch_inet_models "$FETCH_MODE" "$OUT_DIR" || FETCH_INCOMPLETE=true
    write_verify_script "$OUT_DIR"
    generate_manifest "$OUT_DIR"
    echo ""
    if [ "$FETCH_INCOMPLETE" = "true" ]; then
        echo "[WARN] $(_ "Fetch finished with errors: some models may be missing. Re-run the same fetch command to retry.")" >&2
        exit 1
    fi
    echo "$(_ "Repository ready:") $OUT_DIR"
    exit 0
fi

# --- Subcomando: traduia-make-repo debs <output_dir> [jammy|noble|all]
#                  [--url-jammy <url>] [--url-noble <url>] ---
# Descarga los paquetes del sistema (traduia, zero-lliurex-traduia)
# leyendo los índices apt del repositorio indicado por HTTP (sin apt:
# independiente de la distribución de la máquina que lo ejecuta).
# Layout: <out>/debs/{jammy,noble}/. Los debs se toman de la versión
# mayor disponible en las suites <s>, <s>-updates y <s>-security, con
# verificación sha256 contra el índice. Defaults: ambas distros desde
# lliurex.net; con --url-* se apunta al repositorio con los debs más
# actualizados (admite file:// para pruebas).
DEBS_URL_DEFAULT_JAMMY="http://lliurex.net/jammy"
DEBS_URL_DEFAULT_NOBLE="http://lliurex.net/noble"

# parse_debs_url_opts <args...>: procesa --url-jammy/--url-noble (con o
# sin =, en cualquier posición) y deja el resto en DEBS_REST. Fija
# DEBS_URL_JAMMY/DEBS_URL_NOBLE (compartido por los subcomandos debs y
# full); debe llamarse con esos defaults ya asignados.
parse_debs_url_opts() {
    DEBS_REST=()
    while [ "$#" -gt 0 ]; do
        a="$1"
        case "$a" in
            --url-jammy)
                if [ "$#" -lt 2 ]; then
                    echo "[ERROR] $(_ "--url-jammy requires a value: --url-jammy <url>")" >&2
                    exit 1
                fi
                DEBS_URL_JAMMY="$2"
                shift 2
                ;;
            --url-jammy=*)
                DEBS_URL_JAMMY="${a#--url-jammy=}"
                shift
                ;;
            --url-noble)
                if [ "$#" -lt 2 ]; then
                    echo "[ERROR] $(_ "--url-noble requires a value: --url-noble <url>")" >&2
                    exit 1
                fi
                DEBS_URL_NOBLE="$2"
                shift 2
                ;;
            --url-noble=*)
                DEBS_URL_NOBLE="${a#--url-noble=}"
                shift
                ;;
            *)
                DEBS_REST+=("$a")
                shift
                ;;
        esac
    done
}

if [ "${POSITIONAL[0]:-}" = "debs" ]; then
    DEBS_URL_JAMMY="$DEBS_URL_DEFAULT_JAMMY"
    DEBS_URL_NOBLE="$DEBS_URL_DEFAULT_NOBLE"
    parse_debs_url_opts "${POSITIONAL[@]:1}"
    if [ "${#DEBS_REST[@]}" -lt 1 ] || [ "${#DEBS_REST[@]}" -gt 2 ]; then
        usage
        exit 1
    fi
    OUT_DIR="${DEBS_REST[0]}"
    DEBS_DISTRO="${DEBS_REST[1]:-all}"
    case "$DEBS_DISTRO" in
        jammy|noble|all) ;;
        *)
            echo "$(_ "Error: distribution must be 'jammy', 'noble' or 'all'.")" >&2
            exit 1
            ;;
    esac
    mkdir -p "$OUT_DIR"
    rc=0
    case "$DEBS_DISTRO" in
        jammy) make_debs "$OUT_DIR" jammy "$DEBS_URL_JAMMY" || rc=$? ;;
        noble) make_debs "$OUT_DIR" noble "$DEBS_URL_NOBLE" || rc=$? ;;
        all)
            make_debs "$OUT_DIR" jammy "$DEBS_URL_JAMMY" || rc=$?
            make_debs "$OUT_DIR" noble "$DEBS_URL_NOBLE" || rc=$?
            ;;
    esac
    write_verify_script "$OUT_DIR"
    generate_manifest "$OUT_DIR"
    echo ""
    if [ "$rc" -ne 0 ]; then
        echo "[ERROR] $(_ "Could not download the system packages (see the errors above).")" >&2
        exit 1
    fi
    echo "$(_ "Repository ready:") $OUT_DIR"
    exit 0
fi

# --- Subcomando: traduia-make-repo full <output_dir> [--url-jammy <url>] [--url-noble <url>] ---
# Genera un repositorio 100% offline con un solo comando: todos los
# modelos (fetch all desde HuggingFace), los wheels Python (jammy y
# noble) y los debs del sistema de ambas distribuciones. Si un paso
# falla se continúan los demás y se avisa al final (todo es idempotente:
# re-ejecutar reintenta solo lo que falta).
if [ "${POSITIONAL[0]:-}" = "full" ]; then
    DEBS_URL_JAMMY="$DEBS_URL_DEFAULT_JAMMY"
    DEBS_URL_NOBLE="$DEBS_URL_DEFAULT_NOBLE"
    parse_debs_url_opts "${POSITIONAL[@]:1}"
    if [ "${#DEBS_REST[@]}" -ne 1 ]; then
        usage
        exit 1
    fi
    OUT_DIR="${DEBS_REST[0]}"
    mkdir -p "$OUT_DIR"
    echo "[full] $(_ "Building a fully offline repository:") $OUT_DIR"
    rc=0
    fetch_inet_models all "$OUT_DIR" || rc=$?
    make_wheels "$OUT_DIR" || rc=$?
    make_debs "$OUT_DIR" jammy "$DEBS_URL_JAMMY" || rc=$?
    make_debs "$OUT_DIR" noble "$DEBS_URL_NOBLE" || rc=$?
    write_verify_script "$OUT_DIR"
    generate_manifest "$OUT_DIR"
    echo ""
    if [ "$rc" -ne 0 ]; then
        echo "[WARN] $(_ "Offline repository built with errors; re-run the same command to retry what is missing.")" >&2
        exit 1
    fi
    echo "$(_ "Repository ready:") $OUT_DIR"
    exit 0
fi

if [ "${#POSITIONAL[@]}" -lt 3 ] || [ "${#POSITIONAL[@]}" -gt 3 ]; then
    usage
    exit 1
fi

SRC_DIR="$(cd "$(dirname "${POSITIONAL[0]}")" && pwd)/$(basename "${POSITIONAL[0]}")"
MODE="${POSITIONAL[1]}"
OUT_DIR="${POSITIONAL[2]}"

if [ "$MODE" != "ct2" ] && [ "$MODE" != "marian" ] && [ "$MODE" != "all" ]; then
    echo "$(_ "Error: mode must be 'ct2', 'marian' or 'all'.")" >&2
    exit 1
fi

if [ ! -d "$SRC_DIR" ]; then
    echo "$(_ "Error: models directory does not exist:") $SRC_DIR" >&2
    exit 1
fi

WHISPER_DIR="$SRC_DIR/$WHISPER_PREFIX"
if [ "$MODE" = "all" ]; then
    SETS=(ct2 marian)
else
    SETS=("$MODE")
fi

missing_files=()
expected_files=()

# --- Build expected file lists ---
WHISPER_FILES=(
    "model.bin"
    "config.json"
)
for f in "${WHISPER_FILES[@]}"; do
    expected_files+=("$WHISPER_PREFIX/$f")
done

if [ "$MODE" = "ct2" ] || [ "$MODE" = "all" ]; then
    CT2_MANDATORY_FILES=(
        "model.bin"
        "config.json"
        "source.spm"
        "target.spm"
    )
    for pair in "${MARIAN_PAIRS[@]}"; do
        for f in "${CT2_MANDATORY_FILES[@]}"; do
            expected_files+=("ct2/opus-mt-$pair/$f")
        done
    done
fi
if [ "$MODE" = "marian" ] || [ "$MODE" = "all" ]; then
    MARIAN_REQUIRED_FILES=(
        "pytorch_model.bin"
        "config.json"
        "source.spm"
        "target.spm"
        "vocab.json"
    )
    for pair in "${MARIAN_PAIRS[@]}"; do
        for f in "${MARIAN_REQUIRED_FILES[@]}"; do
            expected_files+=("marian/opus-mt-$pair/$f")
        done
    done
fi

# --- Validate expected files ---
for rel in "${expected_files[@]}"; do
    abs="$SRC_DIR/$rel"
    if [ ! -f "$abs" ] || [ ! -s "$abs" ]; then
        missing_files+=("$rel")
    fi
done

# Vocabulario ct2: vocabulary.txt (conversión local) o vocab.json (pre-convertido)
if [ "$MODE" = "ct2" ] || [ "$MODE" = "all" ]; then
    for pair in "${MARIAN_PAIRS[@]}"; do
        base="ct2/opus-mt-$pair"
        if [ ! -s "$SRC_DIR/$base/vocabulary.txt" ] && [ ! -s "$SRC_DIR/$base/vocab.json" ]; then
            missing_files+=("$base/vocabulary.txt o vocab.json")
        fi
    done
fi

if [ "${#missing_files[@]}" -gt 0 ]; then
    echo "$(_ "Error: the following required files are missing or empty:")" >&2
    for m in "${missing_files[@]}"; do
        echo "  - $m" >&2
    done
    echo "$(_ "Refusing to generate an incomplete repository.")" >&2
    exit 1
fi

# --- Assemble output tree (aditivo: whisper compartido, sets acumulativos) ---
echo "$(_ "Assembling repository in:") $OUT_DIR"
mkdir -p "$OUT_DIR"

# Autodetección hardlink vs copia: mismo filesystem (device) => hardlink.
# Se puede forzar la copia con --copy.
USE_COPY=false
if [ "$COPY_MODE" = "true" ]; then
    USE_COPY=true
    echo "$(_ "Copying files (forced by --copy)...")"
elif [ "$(stat -c %d "$SRC_DIR" 2>/dev/null)" = "$(stat -c %d "$OUT_DIR" 2>/dev/null)" ] \
    && [ -n "$(stat -c %d "$SRC_DIR" 2>/dev/null)" ]; then
    echo "$(_ "Source and destination are on the same filesystem: using hardlinks.")"
else
    USE_COPY=true
    echo "$(_ "Source and destination are on different filesystems: copying files.")"
fi

copy_or_link() {
    local src="$1"
    local dst="$2"
    if [ "$USE_COPY" = "true" ]; then
        cp -a "$src" "$dst"
    else
        ln -f "$src" "$dst" 2>/dev/null || cp -a "$src" "$dst"
    fi
}

if [ -d "$OUT_DIR/$WHISPER_PREFIX" ]; then
    echo "$(_ "whisper-small already present, skipping copy.")"
else
    # Copia de whisper-small excluyendo .cache (artefactos de HuggingFace)
    mkdir -p "$OUT_DIR/$WHISPER_PREFIX"
    while IFS= read -r -d '' f; do
        rel="${f#"$WHISPER_DIR"/}"
        mkdir -p "$(dirname "$OUT_DIR/$WHISPER_PREFIX/$rel")"
        copy_or_link "$f" "$OUT_DIR/$WHISPER_PREFIX/$rel"
    done < <(find "$WHISPER_DIR" -name .cache -prune -o -type f -print0)
fi

# Copiar/refrescar los sets solicitados (idempotente; excluye *.h5, no usados)
for set in "${SETS[@]}"; do
    mkdir -p "$OUT_DIR/$set"
    for pair in "${MARIAN_PAIRS[@]}"; do
        src_pair="$SRC_DIR/$set/opus-mt-$pair"
        dst_pair="$OUT_DIR/$set/opus-mt-$pair"
        mkdir -p "$dst_pair"
        for f in "$src_pair"/*; do
            [ -e "$f" ] || continue
            case "$f" in
                *.h5) continue ;;
            esac
            copy_or_link "$f" "$dst_pair/"
        done
    done
done

# Aviso: sets en el directorio de salida que parecen incompletos
check_output_set() {
    local set_name="$1"
    local file_name="$2"
    if [ -d "$OUT_DIR/$set_name" ]; then
        local incomplete=false
        for pair in "${MARIAN_PAIRS[@]}"; do
            if [ ! -s "$OUT_DIR/$set_name/opus-mt-$pair/$file_name" ]; then
                incomplete=true
            fi
        done
        if [ "$incomplete" = "true" ]; then
            echo "[WARN] $(_ "The {} set in the output directory seems incomplete (missing some pairs).")" | sed "s|{}|$set_name|"
        fi
    fi
}
check_output_set "ct2" "model.bin"
check_output_set "marian" "pytorch_model.bin"

# --- Verificador de integridad (viaja con el repositorio, junto al manifest) ---
write_verify_script "$OUT_DIR"

# --- Generate manifest.json with full sha256 hashing ---
generate_manifest "$OUT_DIR"

echo ""
echo "$(_ "Repository ready:") $OUT_DIR"
echo "$(_ "Publish it statically over HTTP or copy it to a USB drive.")"
echo ""
echo "$(_ "Example rsync to a server:")"
echo "  rsync -a $OUT_DIR/ server:/var/www/public/models/traduia/"
