import gzip
import hashlib
import os
import re
import shutil
import subprocess
import sys
import urllib.request

distro = sys.argv[1]
out_dir = sys.argv[2]
debs_dir = sys.argv[3]
sources_file = sys.argv[4]
local_dir = sys.argv[5]
