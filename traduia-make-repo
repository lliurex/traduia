# =========================================================
# finalize_out_dir <out_dir>: prepara el árbol de salida para su
# distribución (USB/HTTP): elimina artefactos innecesarios de
# HuggingFace (.cache de metadatos de descarga y .gitattributes
# de los repos) y garantiza permisos de lectura universal (a+rX),
# con independencia de la umask de la sesión que ejecuta el
# comando (p. ej. sudo). Los bits de ejecución ya existentes
# (verify-models.py) se conservan.
# =========================================================
finalize_out_dir() {
    local dir="$1"
    [ -d "$dir" ] || return 0
    # El borrado se mantiene estricto (nunca a través de un symlink que
    # escape), pero un árbol con symlinks hacia otro disco no debe romper la
    # creación del repositorio: se avisa y se omite la limpieza.
    if ! safe_within_or_equal "$OUT_DIR" "$dir"; then
        echo "[WARN] $(_ "Skipping cleanup outside the output directory:") $dir" >&2
        return 0
    fi
    safe_find_cache "$OUT_DIR" "$dir" || true
    find -P "$dir" -type f -name .gitattributes -delete 2>/dev/null || true
    chmod -R a+rX "$dir" 2>/dev/null || true
}

# =========================================================
# generate_manifest <out_dir>: (re)genera manifest.json con
# tamaño+sha256 de todo el árbol (sets, wheels, verify-models.py).
# =========================================================
generate_manifest() {
    local out_dir="$1"
    finalize_out_dir "$out_dir"
    echo "$(_ "Hashing files (sha256)...")"
    python3 - "$out_dir" <<'PY'
import hashlib
import json
import os
import sys
from datetime import datetime, timezone

out_dir = sys.argv[1]
ALLOWED_TOP = ("whisper-small/", "ct2/", "marian/", "wheels/", "debs/")
ROOT_FILES = (
    "verify-models.py",
    "install-offline.sh",
    "debs-jammy.txt",
    "debs-noble.txt",
    "debs-sources.conf",
)


def is_expected_path(rel):
    if rel in ROOT_FILES:
        return True
    return rel.startswith(ALLOWED_TOP)


def _has_set(sub):
    sub_dir = os.path.join(out_dir, sub)
    if not os.path.isdir(sub_dir):
        return False
    return any(os.path.isdir(os.path.join(sub_dir, d)) for d in os.listdir(sub_dir))


ct2_set = _has_set("ct2")
marian_set = _has_set("marian")
if ct2_set and marian_set:
    mode = "both"
elif ct2_set:
    mode = "ct2"
elif marian_set:
    mode = "marian"
else:
    mode = "none"

files = []
skipped = []
for root, dirs, fnames in os.walk(out_dir):
    # Excluir .cache (artefactos de HuggingFace)
    dirs[:] = [d for d in dirs if d != ".cache"]
    dirs.sort()
    for fname in sorted(fnames):
        if fname.endswith(".h5"):
            continue
        abs_path = os.path.join(root, fname)
        rel_path = os.path.relpath(abs_path, out_dir)
        if rel_path == "manifest.json":
            continue
        # El manifest solo declara rutas que el instalador va a consumir:
        # cualquier otra cosa (.DS_Store, README suelto, basura de USB) se
        # avisa y se omite para que el repo generado sea canonico.
        if not is_expected_path(rel_path):
            skipped.append(rel_path)
            continue
        size = os.path.getsize(abs_path)
        sha = hashlib.sha256()
        with open(abs_path, "rb") as fh:
            for chunk in iter(lambda: fh.read(1024 * 1024), b""):
                sha.update(chunk)
        files.append({"path": rel_path, "size": size, "sha256": sha.hexdigest()})
        print(f"[hash] {rel_path} ({size} bytes)")

manifest = {
    "version": 1,
    "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "mode": mode,
    "files": files,
}

# Escritura atómica: os.replace sustituye el enlace en vez de escribir a
# través de él, así que un manifest.json preexistente que sea symlink no
# puede redirigir la escritura fuera del repositorio.
manifest_out = os.path.join(out_dir, "manifest.json")
manifest_tmp = manifest_out + ".tmp"
with open(manifest_tmp, "w", encoding="utf-8") as fh:
    json.dump(manifest, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
os.replace(manifest_tmp, manifest_out)

if skipped:
    print(f"[WARN] {len(skipped)} file(s) outside known prefixes were NOT added to the manifest:", file=sys.stderr)
    for rel in skipped[:5]:
        print(f"  - {rel}", file=sys.stderr)

print(f"[ok] manifest.json written with {len(files)} files (mode={mode})")
PY
}

# =========================================================
# write_verify_script <out_dir>: escribe (o refresca) junto al
# manifest el verificador de integridad verify-models.py, para
# que el repositorio lo lleve siempre consigo. Se invoca desde
# todos los subcomandos que generan manifest (local, fetch,
# wheels y debs); es idempotente.
# =========================================================
write_verify_script() {
    local out_dir="$1"
    local vtarget="$out_dir/verify-models.py"
    if [ -L "$vtarget" ]; then
        echo "[ERROR] $(_ "Refusing to overwrite a symlink:") $vtarget" >&2
        return 1
    fi
    if ! safe_within_or_equal "$OUT_DIR" "$vtarget"; then
        echo "[ERROR] $(_ "Refusing to write outside output directory:") $vtarget" >&2
        return 1
    fi
    cat > "$vtarget" <<'PY'
#!/usr/bin/env python3
"""Verifica la integridad del repositorio contra manifest.json.

Uso: python3 verify-models.py [--mode ct2|marian] [directorio]
     (directorio por defecto: el actual; --mode verifica solo whisper + un set)
"""
import hashlib
import json
import os
import sys
from datetime import datetime, timezone

ALLOWED_TOP = ("whisper-small/", "ct2/", "marian/", "wheels/", "debs/")
ROOT_FILES = (
    "verify-models.py",
    "install-offline.sh",
    "debs-jammy.txt",
    "debs-noble.txt",
    "debs-sources.conf",
)
MAX_MANIFEST_BYTES = 64 * 1024 * 1024
MAX_ENTRIES = 100000
MAX_PATH = 4096


def is_expected_path(rel):
    if rel in ROOT_FILES:
        return True
    return rel.startswith(ALLOWED_TOP)


def safe_rel(rel):
    if not isinstance(rel, str) or not rel or "\x00" in rel:
        return False
    if rel.startswith("/") or "\\" in rel:
        return False
    if len(rel) > MAX_PATH:
        return False
    norm = os.path.normpath(rel)
    if norm != rel or norm in (".", "..") or norm.startswith("../"):
        return False
    return True


PROTECTED_TREES = ("/usr", "/etc", "/boot", "/var", "/run", "/root", "/home",
                   "/proc", "/sys", "/dev", "/bin", "/sbin", "/lib", "/lib32", "/lib64")
SYMLINK_POLICY = os.environ.get("TRADUIA_SYMLINK_POLICY", "allow-dirs")


def is_protected_target(path):
    if path == "/":
        return True
    for t in PROTECTED_TREES:
        if path == t or path.startswith(t + "/"):
            return True
    return False


def escapes_base(real_base, target):
    try:
        return os.path.commonpath([real_base, target]) != real_base
    except ValueError:
        return True


def safe_join(base, rel):
    # Defensa en profundidad: aunque los llamadores validan con safe_rel,
    # la primitiva rechaza por sí misma rutas absolutas o con "..".
    if not isinstance(rel, str) or not rel or rel.startswith("/") or ".." in rel.split("/"):
        raise ValueError(rel)
    real_base = os.path.realpath(base)
    if real_base == "/":
        raise ValueError(rel)
    joined = os.path.join(real_base, rel)
    target = os.path.realpath(joined)
    if target == real_base:
        raise ValueError(rel)
    if not escapes_base(real_base, target):
        return target
    # Fuera del base: solo se permiten symlinks de DIRECTORIO hacia destinos
    # de datos. Nunca hacia árboles de sistema (/etc, /usr, ...) ni symlinks
    # de fichero. TRADUIA_SYMLINK_POLICY=strict restaura el rechazo total.
    if SYMLINK_POLICY == "strict" or is_protected_target(target):
        raise ValueError(rel)
    acc = real_base
    for part in rel.split("/"):
        acc = os.path.join(acc, part)
        if os.path.islink(acc) and not os.path.isdir(acc):
            raise ValueError(rel)
    return target


def parse_args(argv):
    mode = None
    rebuild = False
    repo = "."
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--rebuild-manifest":
            rebuild = True
        elif a == "--mode":
            i += 1
            if i >= len(argv):
                print("ERROR: --mode requires 'ct2' or 'marian'.", file=sys.stderr)
                sys.exit(2)
            mode = argv[i]
        elif a.startswith("--mode="):
            mode = a.split("=", 1)[1]
        else:
            repo = a
        i += 1
    if mode not in (None, "ct2", "marian"):
        print(f"ERROR: unknown mode: {mode}", file=sys.stderr)
        sys.exit(2)
    return repo, mode, rebuild


def rebuild_manifest(repo):
    """Regenera manifest.json con el contenido actual del árbol.

    Mismo recorrido que generate_manifest de traduia-make-repo:
    excluye los directorios .cache de HuggingFace, los pesos .h5 no
    usados y el propio manifest.json. Escritura atómica y legible
    por todos. Uso avanzado (parámetro oculto).
    """
    manifest_path = os.path.join(repo, "manifest.json")
    files = []
    for root, dirs, fnames in os.walk(repo):
        dirs[:] = [d for d in dirs if d != ".cache"]
        dirs.sort()
        for fname in sorted(fnames):
            if fname.endswith(".h5"):
                continue
            abs_path = os.path.join(root, fname)
            rel_path = os.path.relpath(abs_path, repo)
            if rel_path == "manifest.json":
                continue
            try:
                size = os.path.getsize(abs_path)
                h = hashlib.sha256()
                with open(abs_path, "rb") as fh:
                    for chunk in iter(lambda: fh.read(1024 * 1024), b""):
                        h.update(chunk)
            except OSError as e:
                print(f"ERROR NO LEGIBLE: {rel_path} ({e})", file=sys.stderr)
                return 1
            files.append({"path": rel_path, "size": size, "sha256": h.hexdigest()})

    def _has_set(sub):
        sub_dir = os.path.join(repo, sub)
        if not os.path.isdir(sub_dir):
            return False
        return any(os.path.isdir(os.path.join(sub_dir, d)) for d in os.listdir(sub_dir))

    ct2_set = _has_set("ct2")
    marian_set = _has_set("marian")
    if ct2_set and marian_set:
        mode = "both"
    elif ct2_set:
        mode = "ct2"
    elif marian_set:
        mode = "marian"
    else:
        mode = "none"

    if not files:
        print("ERROR: no hay ficheros para el manifest.", file=sys.stderr)
        return 1

    manifest = {
        "version": 1,
        "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "mode": mode,
        "files": files,
    }
    try:
        tmp_path = safe_join(repo, "manifest.json.tmp")
    except ValueError:
        print("ERROR: ruta de manifest no segura.", file=sys.stderr)
        return 1
    try:
        with open(tmp_path, "w", encoding="utf-8") as fh:
            json.dump(manifest, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        os.replace(tmp_path, manifest_path)
        os.chmod(manifest_path, 0o644)
    except OSError as e:
        print(f"ERROR: no se pudo escribir {manifest_path}: {e}", file=sys.stderr)
        try:
            os.remove(tmp_path)
        except OSError:
            pass
        return 1
    print(f"[rebuild] manifest.json regenerado: {len(files)} ficheros (mode={mode})")
    print("AVISO: el manifest refleja el contenido actual del repositorio.")
    return 0


def wanted(rel, mode):
    if mode is None:
        return is_expected_path(rel)
    return rel.startswith("whisper-small/") or rel.startswith(f"{mode}/")


def main():
    repo, mode, rebuild = parse_args(sys.argv[1:])

    if rebuild:
        sys.exit(rebuild_manifest(repo))

    manifest_path = os.path.join(repo, "manifest.json")

    try:
        if os.path.getsize(manifest_path) > MAX_MANIFEST_BYTES:
            print("ERROR: manifest.json es demasiado grande.", file=sys.stderr)
            sys.exit(1)
        with open(manifest_path, encoding="utf-8") as fh:
            manifest = json.load(fh)
    except (json.JSONDecodeError, OSError, ValueError) as e:
        print(f"ERROR: no se pudo leer {manifest_path}: {e}", file=sys.stderr)
        sys.exit(1)

    if not isinstance(manifest, dict):
        print("ERROR: manifest.json no es un objeto.", file=sys.stderr)
        sys.exit(1)
    version = manifest.get("version")
    if version is not None and (not isinstance(version, int) or isinstance(version, bool)):
        print("ERROR: manifest.json contiene una version invalida.", file=sys.stderr)
        sys.exit(1)
    mmode = manifest.get("mode")
    if mmode is not None and mmode not in ("ct2", "marian", "both", "none"):
        print("ERROR: manifest.json contiene un mode invalido.", file=sys.stderr)
        sys.exit(1)

    files = manifest.get("files", [])
    if not isinstance(files, list) or not files:
        print("ERROR: manifest.json no contiene ficheros.", file=sys.stderr)
        sys.exit(1)
    if len(files) > MAX_ENTRIES:
        print("ERROR: manifest.json contiene demasiados ficheros.", file=sys.stderr)
        sys.exit(1)

    unexpected = []
    seen = set()
    for entry in files:
        if not isinstance(entry, dict) or not safe_rel(entry.get("path")):
            print(f"ERROR: manifest.json contiene una ruta no segura: {entry!r}", file=sys.stderr)
            sys.exit(1)
        rel = entry["path"]
        if rel in seen:
            print(f"ERROR: manifest.json contiene una ruta duplicada: {rel}", file=sys.stderr)
            sys.exit(1)
        seen.add(rel)
        if not is_expected_path(rel):
            unexpected.append(rel)

    # Rutas fuera de los prefijos conocidos: aviso e ignoradas (no instaladas).
    if unexpected:
        print(f"[WARN] manifest.json contiene {len(unexpected)} ruta(s) inesperada(s) fuera de los prefijos conocidos; se ignoraran", file=sys.stderr)
        for rel in unexpected[:5]:
            print("  - " + rel, file=sys.stderr)

    if mode is not None and not any(e["path"].startswith(f"{mode}/") for e in files):
        print(f"ERROR: no hay entradas del modo '{mode}' en el manifest.", file=sys.stderr)
        sys.exit(1)

    errors = 0
    for entry in files:
        rel = entry["path"]
        if not wanted(rel, mode):
            continue
        try:
            p = safe_join(repo, rel)
        except ValueError:
            print("RUTA NO SEGURA:", rel)
            errors += 1
            continue
        try:
            if not os.path.exists(p) or os.path.getsize(p) != entry.get("size"):
                print("FALTA/TAMAÑO:", rel)
                errors += 1
                continue
            sha = entry.get("sha256")
            if not sha:
                print("OK:", rel)
                continue
            h = hashlib.sha256()
            with open(p, "rb") as fh:
                for chunk in iter(lambda: fh.read(1024 * 1024), b""):
                    h.update(chunk)
            if h.hexdigest() != sha:
                print("SHA256 INCORRECTO:", rel)
                errors += 1
            else:
                print("OK:", rel)
        except OSError as e:
            print(f"ERROR NO LEGIBLE: {rel} ({e})")
            errors += 1

    print("OK" if errors == 0 else f"{errors} errores")
    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
