#!/bin/bash

ACTION="$1"
shift
PACKAGE_LIST="$*"

TRADUIA_CONFIG="/usr/sbin/traduia-config"

has_pkg() {
    [[ " $PACKAGE_LIST " == *" $1 "* ]]
}

pkg_installed() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

warn() {
    echo "[WARN] $*" >&2
}

case "$ACTION" in
    getStatus)
        for pkg in "$@"; do
            if pkg_installed "$pkg"; then echo 0; else echo 1; fi
        done
        exit 0
        ;;
    download)
        exit 0
        ;;
    preInstall)
        if has_pkg traduia; then
            if [ -x "$TRADUIA_CONFIG" ]; then
                "$TRADUIA_CONFIG" preinstall
                exit $?
            fi
            warn "traduia-config not found; skipping preinstall"
        fi
        exit 0
        ;;
    installPackage)
        if has_pkg traduia; then
            if [ -x "$TRADUIA_CONFIG" ]; then
                "$TRADUIA_CONFIG" install-package traduia
                exit $?
            fi
            warn "traduia-config not found; installing traduia with apt"
            LANG=C LANGUAGE=en DEBIAN_FRONTEND=noninteractive \
                apt-get install --reinstall --allow-downgrades --yes traduia
            exit $?
        fi
        exit 0
        ;;
    postInstall)
        if has_pkg traduia; then
            if [ -x "$TRADUIA_CONFIG" ]; then
                "$TRADUIA_CONFIG" postinstall
                exit $?
            fi
            warn "traduia-config not found; skipping postinstall"
        fi
        exit 0
        ;;
    remove)
        if has_pkg traduia; then
            if [ -x "$TRADUIA_CONFIG" ]; then
                "$TRADUIA_CONFIG" remove
                exit $?
            fi
            warn "traduia-config not found; removing traduia with apt"
            DEBIAN_FRONTEND=noninteractive apt-get remove -y traduia
            exit $?
        fi
        exit 0
        ;;
    *)
        exit 1
        ;;
esac
