#!/bin/bash
#
# traduia-config - Configuración de TraduIA (zero-center y standalone)
#
#   traduia-config                        → interactivo: detecta el paquete y
#                                           ofrece Install/Remove (solo Install
#                                           si no está detectado)
#   traduia-config install                → preinstall + instalación del
#                                           paquete traduia (deb del repo
#                                           USB/LAN si su versión es >= a la
#                                           de apt; si no, apt-get install)
#                                           + postinstall (reinstalación)
#   traduia-config remove                 → pregunta de modelos + apt-get remove
#                                           + limpieza de entradas/modelos
#   traduia-config preinstall             → Q&A (modo/origen/optimización) +
#                                           marcadores (sin apt; lo hace el
#                                           script superior de zero-center)
#   traduia-config postinstall            → override del paquete con el deb
#                                           del repo (USB/LAN, versión >= a la
#                                           instalada) + descarga de modelos +
#                                           entradas web (sin apt; consume los
#                                           marcadores)
#   traduia-config status                 → estado de las entradas web
#   traduia-config validate <dir|url>     → validación rápida de repositorio
#
# Opción global (antes o después del comando):
#   --disable-meta-checks                 → omite la comprobación de metas
#                                           (equivale a TRADUIA_SKIP_METAS_CHECK=1)
#
# Permisos: help, status y validate con ruta local funcionan sin root
# (solo lectura, sin descargas). El resto (install, remove, preinstall,
# postinstall y validate con URL) requiere root: se lanza con sudo, pkexec
# o desde una terminal de root; en otro caso se muestra un aviso y termina.

# Configuración de gettext
export TEXTDOMAIN="zero-lliurex-traduia"
export TEXTDOMAINDIR="/usr/share/locale"

# Función para simplificar la llamada a gettext
_() {
    gettext -- "$1"
}

# kdialog con stderr silenciado: los frameworks KDE ensucian la consola
# (p.ej. "kf.kio.widgets: Cannot read information about ...").
function kdialog() {
    command kdialog "$@" 2>/dev/null
}

# Actualiza el estado de zero-center sin asumir que el comando está
# disponible. El estado no es crítico para la instalación.
zero_center_set() {
    local action="$1" app="$2"
    if ! command -v zero-center >/dev/null 2>&1; then
        echo "[WARN] $(_ "zero-center not available; skipping state update")" >&2
        return 0
    fi
    if ! zero-center "$action" "$app" >/dev/null 2>&1; then
        echo "[WARN] $(_ "zero-center state update failed")" >&2
    fi
    return 0
}

# >>> SAFE RM (begin)
# Borrados confinados a un basedir. safe_within resuelve symlinks con
# realpath -m y exige que el destino quede estrictamente dentro del base.
safe_within() {
    local base="$1" path="$2" real_base real_path
    [ -n "$base" ] && [ -n "$path" ] || return 1
    real_base="$(realpath -m -- "$base" 2>/dev/null)" || return 1
    real_path="$(realpath -m -- "$path" 2>/dev/null)" || return 1
    [ -n "$real_base" ] && [ -n "$real_path" ] || return 1
    [ "$real_base" != "/" ] || return 1
    [ "$real_path" != "/" ] || return 1
    [ "$real_path" != "$real_base" ] || return 1
    case "$real_path" in
        "$real_base"/*) return 0 ;;
        *) return 1 ;;
    esac
}

safe_rm_rf() {
    [ $# -ge 1 ] || return 1
    local base="$1"; shift
    local p
    [ $# -gt 0 ] || return 1
    for p in "$@"; do
        if safe_within "$base" "$p"; then
            rm -rf -- "$p"
        else
            echo "[ERROR] Refusing to remove outside base: $p (base: $base)" >&2
            return 1
        fi
    done
}

safe_rm_f() {
    [ $# -ge 1 ] || return 1
    local base="$1"; shift
    local p
    [ $# -gt 0 ] || return 1
    for p in "$@"; do
        if safe_within "$base" "$p"; then
            rm -f -- "$p"
        else
            echo "[ERROR] Refusing to remove outside base: $p (base: $base)" >&2
            return 1
        fi
    done
}
# <<< SAFE RM (end)

TRADUIA_DATA_BASE="/opt/ai/traduia"
TMP_BASE="${TMPDIR:-/tmp}"
# TMP_BASE debe ser usable como basedir de borrado: canonicalizado y nunca "/".
TMP_BASE="$(realpath -m -- "$TMP_BASE" 2>/dev/null || true)"
if [ -z "$TMP_BASE" ] || [ "$TMP_BASE" = "/" ]; then
    TMP_BASE="/tmp"
fi

# Aborta la operación por cancelación del usuario, limpiando los
# marcadores temporales para que el reintento empiece limpio.
function abort_install() {
    echo "[INFO] $(_ "Installation cancelled")"
    safe_rm_f "$TMP_BASE" "$TRADUIA_MODE_FILE" "$TRADUIA_SOURCE_FILE" "$TRADUIA_OPTIMIZE_FILE" "$TRADUIA_PIPER_FILE" "$TRADUIA_APT_ENV" || true
    cleanup_apt_env || true
    exit 1
}

# Las operaciones que modifican el sistema requieren root.
function require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "[ERROR] $(_ "This command must be run as root")" >&2
        exit 1
    fi
}

# Poner a 1 para saltar la validación de metas y configurar siempre
# las entradas web (lliurex-firefox-settings / Ainur).
TRADUIA_SKIP_METAS_CHECK="${TRADUIA_SKIP_METAS_CHECK:-0}"
# TRADUIA_SKIP_METAS_CHECK=1   # Descomenta esta línea para saltar la validación de metas

# Marcadores temporales (derivados de TMP_BASE: si el entorno define TMPDIR,
# los ficheros y el basedir de borrado deben coincidir o la limpieza se rechaza)
TRADUIA_MODE_FILE="${TMP_BASE}/.traduia_install_mode"
TRADUIA_SOURCE_FILE="${TMP_BASE}/.traduia_models_source"
TRADUIA_OPTIMIZE_FILE="${TMP_BASE}/.traduia_optimize_model"
TRADUIA_PIPER_FILE="${TMP_BASE}/.traduia_install_piper"
TRADUIA_APT_ENV="${TMP_BASE}/.traduia_apt_env"
CODENAME="$(. /etc/os-release 2>/dev/null; echo "${VERSION_CODENAME:-}")"

# Marcador persistente del modo de instalación (Server/Client)
TRADUIA_MODE_FLAG="/opt/ai/traduia/.mode"

function remove_models(){
    models='/opt/ai/traduia/models'
    if [ -e "$models" ]; then
        safe_rm_rf "$TRADUIA_DATA_BASE" "$models" || true
    fi
}

function remove_venv(){
    venv='/opt/ai/traduia/venv'
    if [ -e "$venv" ]; then
        safe_rm_rf "$TRADUIA_DATA_BASE" "$venv" || true
    fi
}

function remove_execcode(){
    d='/usr/lib/traduia'
    if [ -d "$d" ] && [ "$(realpath -m -- "$d")" = "/usr/lib/traduia" ]; then
        rmdir -- "$d" || true
    fi
}

# =========================================================
# Origen de modelos (Internet/USB/LAN) — validación rápida
# Un repositorio exportado (traduia-make-repo) contiene
# manifest.json con files[] (whisper-small/ + ct2/ y/o marian/).
# =========================================================

# Validación común del manifest: JSON válido, files no vacío y
# al menos un set (ct2/ o marian/).
function valid_repo_manifest() {
    # El manifest es entrada no confiable (USB/LAN). Se exige:
    #  - files[] no vacío, acotado y con entradas objeto de path string normalizado
    #  - rechazo de rutas absolutas, "..", ".", "//", backslash, NUL y barra final
    #  - size numérico >= 0 y sha256 hex64 cuando están presentes
    # Los prefijos conocidos NO son un requisito de seguridad: se avisa de las
    # rutas desconocidas (ver warn_unknown_manifest_paths) y se ignoran aguas abajo.
    jq -e '
        (.files | type == "array" and length > 0 and length <= 100000)
        and ([.files[] | type == "object"] | all)
        and ([.files[] | .path | type == "string" and length > 0 and length <= 4096] | all)
        and ([.files[].path
              | select(startswith("/") or contains("//") or contains("\\")
                       or test("(^|/)\\.(/|$)") or test("(^|/)\\.\\.(/|$)")
                       or endswith("/"))]
             | length == 0)
        and ([.files[] | select(has("size")) | .size
              | type == "number" and . >= 0 and . == floor] | all)
        and ([.files[] | select(has("sha256")) | .sha256
              | type == "string" and test("^[0-9a-fA-F]{64}$")] | all)
        and ([.files[].path | test("^(ct2|marian)/")] | any)
    ' "$1" >/dev/null 2>&1 || return 1
    warn_unknown_manifest_paths "$1"
    return 0
}

# Avisa (sin abortar) de rutas fuera de los prefijos conocidos: se ignoran
# aguas abajo. Los repos generados por traduia-make-repo no las incluyen.
function warn_unknown_manifest_paths() {
    command -v jq >/dev/null 2>&1 || return 0
    local n
    n="$(jq -r '[.files[].path
                 | select((test("^(whisper-small|ct2|marian|wheels|debs)/") or . == "verify-models.py" or . == "install-offline.sh" or . == "debs-jammy.txt" or . == "debs-noble.txt" or . == "debs-sources.conf") | not)]
                | length' "$1" 2>/dev/null)" || return 0
    [ "${n:-0}" -gt 0 ] || return 0
    echo "[WARN] $(_ "manifest.json contains unexpected paths outside known prefixes; they will be ignored"): $n" >&2
    jq -r '[.files[].path
            | select((test("^(whisper-small|ct2|marian|wheels|debs)/") or . == "verify-models.py" or . == "install-offline.sh" or . == "debs-jammy.txt" or . == "debs-noble.txt" or . == "debs-sources.conf") | not)][:5][]
           | "  - " + .' "$1" >&2 2>/dev/null || true
}

# Directorio local (USB): existe, es legible y tiene manifest válido.
function valid_repo_dir() {
    [ -d "$1" ] && [ -r "$1" ] && [ -f "$1/manifest.json" ] && valid_repo_manifest "$1/manifest.json"
}

# URL (LAN): descarga el manifest con timeout corto y lo valida.
function valid_repo_url() {
    local url="${1%/}"
    local tmp
    tmp="$(mktemp)"
    if curl -fsSL --connect-timeout 5 --max-time 10 -o "$tmp" "$url/manifest.json" 2>/dev/null \
        && valid_repo_manifest "$tmp"; then
        safe_rm_f "$TMP_BASE" "$tmp" || true
        return 0
    fi
    safe_rm_f "$TMP_BASE" "$tmp" || true
    return 1
}

# =========================================================
# Deb del paquete traduia en el repositorio (debs/<codename>/)
# Un repositorio exportado puede incluir <repo>/debs/<codename>/
# (jammy, noble) con los
# paquetes del sistema (traduia, zero-lliurex-traduia). Cuando el
# deb de traduia tiene una versión superior o IGUAL a la disponible
# por apt, se instala ese fichero en lugar de descargar por internet.
# =========================================================

REPO_DEB_PATH=""
REPO_DEB_VER=""
REPO_DEB_TMP=""

# True si $1 (versión del deb del repo) es >= $2 (referencia). Si la
# referencia está vacía (sin candidato apt / paquete sin instalar), se
# considera que el deb del repositorio tiene prioridad.
function deb_is_newer_or_equal() {
    local ver="$1" ref="$2"
    [ -z "$ref" ] && return 0
    dpkg --compare-versions "$ver" ge "$ref"
}

# Localiza el deb del paquete traduia en debs/<codename>/ del
# repositorio (origen USB, directorio local, o LAN, URL http/https).
# El codename es el de la máquina (VERSION_CODENAME de /etc/os-release;
# override con TRADUIA_DISTRO_CODENAME): solo se consideran los debs de
# la distribución del equipo. Deja REPO_DEB_PATH (ruta local del deb;
# temporal si viene de LAN, con REPO_DEB_TMP=1) y REPO_DEB_VER (su
# versión). Devuelve 0 si lo encuentra; se elige el de mayor versión
# si hubiera varios.
function find_repo_traduia_deb() {
    local src="${1%/}"
    local codename="${TRADUIA_DISTRO_CODENAME:-}"
    if [ -z "$codename" ] && [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        codename="$(. /etc/os-release && printf '%s' "$VERSION_CODENAME")"
    fi
    local manifest_tmp="" rel f ver best="" bestver=""
    REPO_DEB_PATH=""
    REPO_DEB_VER=""
    REPO_DEB_TMP=""
    if [ -z "$codename" ]; then
        return 1
    fi
    if [[ "$src" == http://* || "$src" == https://* ]]; then
        manifest_tmp="$(mktemp)"
        if ! curl -fsSL --connect-timeout 5 --max-time 15 -o "$manifest_tmp" "$src/manifest.json" 2>/dev/null; then
            safe_rm_f "$TMP_BASE" "$manifest_tmp" || true
            return 1
        fi
        while IFS= read -r rel; do
            [ -n "$rel" ] || continue
            # Manifest no confiable: solo debs/<codename>/<basename>.deb
            case "$rel" in
                debs/"$codename"/*.deb) ;;
                *) continue ;;
            esac
            case "${rel#debs/$codename/}" in
                */*) continue ;;
            esac
            f="$(mktemp)"
            if curl -fsSL --connect-timeout 5 --max-time 30 -o "$f" "$src/$rel" 2>/dev/null \
                && [ "$(dpkg-deb -f "$f" Package 2>/dev/null)" = "traduia" ]; then
                ver="$(dpkg-deb -f "$f" Version 2>/dev/null)"
                if [ -z "$bestver" ] || dpkg --compare-versions "$ver" gt "$bestver"; then
                    best="$f"
                    bestver="$ver"
                else
                    safe_rm_f "$TMP_BASE" "$f" || true
                fi
            else
                safe_rm_f "$TMP_BASE" "$f" || true
            fi
        done < <(jq -r --arg d "debs/$codename/" '.files[] | select(.path | startswith($d)) | .path' "$manifest_tmp" 2>/dev/null | grep '\.deb$')
        safe_rm_f "$TMP_BASE" "$manifest_tmp" || true
    else
        for f in "$src"/debs/"$codename"/*.deb; do
            [ -f "$f" ] || continue
            [ "$(dpkg-deb -f "$f" Package 2>/dev/null)" = "traduia" ] || continue
            ver="$(dpkg-deb -f "$f" Version 2>/dev/null)"
            [ -n "$ver" ] || continue
            if [ -z "$bestver" ] || dpkg --compare-versions "$ver" gt "$bestver"; then
                best="$f"
                bestver="$ver"
            fi
        done
    fi
    if [ -n "$best" ]; then
        REPO_DEB_PATH="$best"
        REPO_DEB_VER="$bestver"
        if [[ "$src" == http://* || "$src" == https://* ]]; then
            REPO_DEB_TMP="1"
        fi
        return 0
    fi
    return 1
}

# =========================================================
# Sitios lliurex-firefox-settings (fichero cards.js)
# =========================================================
TRADUIA_LLXFFOXSETTINGS_CARDS_FILE="/usr/share/lliurex-firefox-settings/www/cards.js"
TRADUIA_LLXFFOXSETTINGS_ICON_DEST="/usr/share/lliurex-firefox-settings/www/search/images/traduia.svg"

# Icono del paquete (árbol propio), fuente para las copias en runtime.
TRADUIA_ICON_SOURCE="/usr/share/zero-lliurex-traduia/traduia.svg"

# Extrae el JSON de "window.LLX_CARDS = { ... };"
function cards_extract_json() {
    sed -e 's/^[[:space:]]*window[[:space:]]*\.LLX_CARDS[[:space:]]*=[[:space:]]*//' \
        -e 's/;[[:space:]]*$//' "$1"
}

function cards_write_json() {
    { printf 'window.LLX_CARDS = %s;\n' "$(cat "$1")"; } > "${TRADUIA_LLXFFOXSETTINGS_CARDS_FILE}.tmp" \
        && mv "${TRADUIA_LLXFFOXSETTINGS_CARDS_FILE}.tmp" "$TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" \
        || { echo "[WARN] $(_ "cards file processing failed:") $TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" >&2; safe_rm_f "/usr/share/lliurex-firefox-settings" "${TRADUIA_LLXFFOXSETTINGS_CARDS_FILE}.tmp" || true; }
}

function create_llxffoxsettings_conf() {
    # Icono propio del paquete, copiado al destino web solo en runtime.
    if [ -f "$TRADUIA_ICON_SOURCE" ]; then
        cp "$TRADUIA_ICON_SOURCE" "$TRADUIA_LLXFFOXSETTINGS_ICON_DEST"
    else
        echo "[WARN] $(_ "icon not found:") $TRADUIA_ICON_SOURCE" >&2
    fi
    if [ -f "$TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" ]; then
        local json
        json="$(cards_extract_json "$TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" \
            | jq '.cards |= ( map(select(.title != "Traduia" and .url != "http://server:8000")) + [{"title":"Traduia","url":"http://server:8000","image":"images/traduia.svg"}] )')" \
            && cards_write_json <(printf '%s\n' "$json") \
            || { echo "[WARN] $(_ "cards file processing failed:") $TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" >&2; safe_rm_f "/usr/share/lliurex-firefox-settings" "${TRADUIA_LLXFFOXSETTINGS_CARDS_FILE}.tmp" || true; }
    else
        echo "[WARN] $(_ "cards file not found:") $TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" >&2
    fi
}

function configure_llxffoxsettings() {
    create_llxffoxsettings_conf
}

# Check común de las entradas web (lliurex-firefox-settings y Ainur):
# solo se configuran si hay metas (lliurex-meta-adi / lliurex-meta-lab-pro)
# instaladas y configuradas. Verboso: informa de cada paquete y del salto.
function check_metas_for_www_entries() {
    if [ "$TRADUIA_SKIP_METAS_CHECK" = "1" ]; then
        echo "[INFO] $(_ "Metas check skipped (TRADUIA_SKIP_METAS_CHECK=1)")"
        return 0
    fi
    TRADUIA_WWW_META_PACKAGES=( "lliurex-meta-adi" "lliurex-meta-lab-pro" )
    for pkg in "${TRADUIA_WWW_META_PACKAGES[@]}"; do
        echo "[INFO] $(_ "Checking LliureX meta:") $pkg"
        # Solo si está instalado y configurado
        if dpkg -s "$pkg" 2>/dev/null | grep -q '^Status: install ok installed'; then
            echo "[INFO] $(_ "LliureX metas found:") $pkg"
            return 0
        fi
        echo "[INFO] $(_ "LliureX meta not installed:") $pkg"
    done
    echo "[WARN] $(_ "Skipping web entries: no LliureX metas installed")" >&2
    return 1
}

function remove_llxffoxsettings_conf(){
    if [ -f "$TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" ]; then
        local json
        json="$(cards_extract_json "$TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" \
            | jq '.cards |= map( if (.title == "Traduia" or .url == "http://server:8000") then {"title":"Traduia","_url":"uninstalled","image":"images/traduia.svg"} else . end )')" \
            && cards_write_json <(printf '%s\n' "$json") \
            || { echo "[WARN] $(_ "cards file processing failed:") $TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" >&2; safe_rm_f "/usr/share/lliurex-firefox-settings" "${TRADUIA_LLXFFOXSETTINGS_CARDS_FILE}.tmp" || true; }
    else
        echo "[WARN] $(_ "cards file not found:") $TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" >&2
    fi
    # El icono copiado al destino web también se limpia.
    safe_rm_f "/usr/share/lliurex-firefox-settings" "$TRADUIA_LLXFFOXSETTINGS_ICON_DEST" || true
}

# =========================================================
# Entrada Ainur (lliurex-www): página principal del servidor
# (/srv lee JSONs de /var/lib/lliurex-www/links — prioridad
# sobre /usr/share/lliurex-www/srv/links — sin reiniciar nada).
# El icono se sirve desde /usr/share/lliurex-www/srv/icons.
# =========================================================
TRADUIA_WWW_LINKS_DIR="/var/lib/lliurex-www/links"
TRADUIA_WWW_ICONS_DIR="/usr/share/lliurex-www/srv/icons"
TRADUIA_WWW_ICON="traduia.svg"
TRADUIA_WWW_ENTRY_URL="http://server:8000"
TRADUIA_WWW_ENTRY_FILE="${TRADUIA_WWW_LINKS_DIR}/traduia.json"

function check_www_package() {
    dpkg -s lliurex-www 2>/dev/null | grep -q '^Status: install ok installed'
}

function create_www_entry() {
    mkdir -p "$TRADUIA_WWW_LINKS_DIR"
    # Icono propio del paquete, copiado al directorio de iconos de la web.
    if [ -f "$TRADUIA_ICON_SOURCE" ]; then
        cp "$TRADUIA_ICON_SOURCE" "$TRADUIA_WWW_ICONS_DIR/$TRADUIA_WWW_ICON"
        chown www-data:www-data "$TRADUIA_WWW_ICONS_DIR/$TRADUIA_WWW_ICON"
    else
        echo "[WARN] $(_ "icon not found:") $TRADUIA_ICON_SOURCE" >&2
    fi
    cat > "$TRADUIA_WWW_ENTRY_FILE" <<EOF
{
    "link": "$TRADUIA_WWW_ENTRY_URL",
    "icon": "$TRADUIA_WWW_ICON",
    "name": {"default": "TraduIA", "valencia": "TraduIA", "es": "TraduIA"},
    "description": {"default": "Traducción automática con IA", "valencia": "Traducció automàtica amb IA", "es": "Traducción automática con IA"},
    "order": 80,
    "editable": true,
    "visibility": true
}
EOF
    chown www-data:www-data "$TRADUIA_WWW_ENTRY_FILE"
}

function remove_www_entry() {
    safe_rm_f "/var/lib/lliurex-www" "$TRADUIA_WWW_ENTRY_FILE" || true
    # El icono copiado al directorio de iconos de la web también se limpia.
    safe_rm_f "/usr/share/lliurex-www" "$TRADUIA_WWW_ICONS_DIR/$TRADUIA_WWW_ICON" || true
}

# =========================================================
# Q&A — preinstall (modo → origen → optimización)
# =========================================================

ask_mode() {
    if [ -f "$TRADUIA_MODE_FILE" ]; then
        mode=$(cat "$TRADUIA_MODE_FILE")
        chown root:root "$TRADUIA_MODE_FILE"
        return
    fi
    mode=""
    while [ ! -n "$mode" ]; do
        # Definimos las etiquetas traducidas para el UI
        CLIENT_LABEL=$(_ "Client")
        SERVER_LABEL=$(_ "Server")

        # kdialog muestra las etiquetas traducidas
        echo "[INFO] $(_ "Asking install mode")"
        selected=$(kdialog --title "$(_ "Mode selector")" --combobox "$(_ "Install mode:")" "$CLIENT_LABEL" "$SERVER_LABEL")
        ret=$?
        if [ $ret -eq 1 ]; then
            abort_install
        fi

        # Mapeamos la selección a un valor interno neutro (en inglés)
        if [ "$selected" == "$SERVER_LABEL" ]; then
            mode="Server"
        else
            mode="Client"
        fi
        echo "[INFO] $(_ "Install mode selected:") $mode"
    done
    # Guardamos el valor interno, no el traducido
    echo "$mode" > "$TRADUIA_MODE_FILE"
}

ask_optimization() {
    OPT_TITLE=$(_ "Model Optimization?")
    OPT_LABEL=$(_ "Optimization mode:")
    OPT_NO=$(_ "Marian")
    OPT_YES=$(_ "Optimized (experimental)")

    echo "[INFO] $(_ "Asking optimization mode")"
    selected=$(kdialog --title "$OPT_TITLE" --combobox "$OPT_LABEL" "$OPT_NO" "$OPT_YES")
    ret=$?
    if [ $ret -ne 0 ]; then
        abort_install
    fi
    echo "[INFO] $(_ "Optimization mode selected:") $selected"
    if [ -n "$selected" ] && [ "$selected" == "$OPT_YES" ]; then
        echo "optimized" > "$TRADUIA_OPTIMIZE_FILE"
    fi
}

# =========================================================
# Origen único de instalación y Piper
# =========================================================

valid_install_repo_dir() {
    local repo="${1%/}"
    [ -n "$repo" ] && [ -d "$repo" ] || return 1
    [ -r "$repo/debs/$CODENAME/Packages" ] || return 1
    if [ "$mode" == "Server" ]; then
        valid_repo_dir "$repo" || return 1
    fi
    return 0
}

# Resuelve la raíz del repositorio a partir de un fichero o directorio
# seleccionado en el diálogo (p. ej. manifest.json, Packages o una
# subcarpeta). Sube por los ancestros hasta encontrar debs/<codename>/Packages
# y, en modo Server, un manifest válido.
find_install_repo_root() {
    local path="$1" dir
    [ -n "$path" ] || return 1
    path="$(realpath -m -- "$path" 2>/dev/null)" || return 1
    dir="$path"
    [ -f "$dir" ] && dir="$(dirname -- "$dir")"
    while [ -n "$dir" ]; do
        if valid_install_repo_dir "$dir"; then
            printf '%s\n' "$dir"
            return 0
        fi
        [ "$dir" = "/" ] && break
        dir="$(dirname -- "$dir")"
    done
    return 1
}

valid_install_repo_url() {
    local url="${1%/}"
    [ -n "$url" ] || return 1
    curl -fsSL --connect-timeout 5 --max-time 10 -o /dev/null "$url/debs/$CODENAME/Packages" 2>/dev/null || return 1
    if [ "$mode" == "Server" ]; then
        valid_repo_url "$url" || return 1
    fi
    return 0
}

ask_install_source() {
    local repo_title repo_filter selected_path repo_path
    SOURCE_TITLE=$(_ "Installation source")
    SOURCE_LABEL=$(_ "Where are the packages and models taken from?")
    SOURCE_INT=$(_ "Internet")
    SOURCE_USB=$(_ "USB")
    SOURCE_LAN=$(_ "LAN")
    INSTALL_SOURCE=""

    while [ -z "$INSTALL_SOURCE" ]; do
        echo "[INFO] $(_ "Asking installation source (Internet/USB/LAN)")"
        selected=$(kdialog --title "$SOURCE_TITLE" --combobox "$SOURCE_LABEL" "$SOURCE_INT" "$SOURCE_USB" "$SOURCE_LAN")
        ret=$?
        if [ $ret -ne 0 ]; then
            abort_install
        fi
        if [ "$selected" == "$SOURCE_INT" ]; then
            INSTALL_SOURCE="internet"
        elif [ "$selected" == "$SOURCE_USB" ]; then
            if [ "$mode" == "Server" ]; then
                repo_title=$(_ "Select manifest.json or the repository folder (USB):")
                repo_filter="*.json"
            else
                repo_title=$(_ "Select the repository folder or a file inside it (USB):")
                repo_filter="*"
            fi
            while [ -z "$INSTALL_SOURCE" ]; do
                echo "[INFO] $(_ "Asking offline repository path (USB)")"
                selected_path=$(kdialog --title "$repo_title" --getopenfilename / "$repo_filter")
                if [ $? -ne 0 ]; then
                    abort_install
                fi
                if repo_path="$(find_install_repo_root "$selected_path")"; then
                    INSTALL_SOURCE="$repo_path"
                else
                    kdialog --error "$(_ "The repository is not valid:") $selected_path"
                    echo "[WARN] $(_ "The repository is not valid:") $selected_path" >&2
                fi
            done
        elif [ "$selected" == "$SOURCE_LAN" ]; then
            while [ -z "$INSTALL_SOURCE" ]; do
                echo "[INFO] $(_ "Asking offline repository URL (LAN)")"
                repo_url=$(kdialog --inputbox "$(_ "Offline repository URL (LAN):")")
                if [ $? -ne 0 ]; then
                    abort_install
                fi
                repo_url="${repo_url%/}"
                if valid_install_repo_url "$repo_url"; then
                    INSTALL_SOURCE="$repo_url"
                else
                    kdialog --error "$(_ "The repository is not valid:") $repo_url"
                    echo "[WARN] $(_ "The repository is not valid:") $repo_url" >&2
                fi
            done
        fi
    done
    echo "$INSTALL_SOURCE" > "$TRADUIA_SOURCE_FILE"
    chown root:root "$TRADUIA_SOURCE_FILE" 2>/dev/null || true
    echo "[INFO] $(_ "Installation source selected:") $INSTALL_SOURCE"
}

ask_piper() {
    if dpkg-query -W -f='${Status}' piper-tts-server 2>/dev/null | grep -q "install ok installed"; then
        echo "no" > "$TRADUIA_PIPER_FILE"
        chown root:root "$TRADUIA_PIPER_FILE" 2>/dev/null || true
        echo "[INFO] $(_ "Piper is already installed; keeping the current voices.")"
        return 0
    fi
    YES_LABEL=$(_ "Yes")
    NO_LABEL=$(_ "No")
    echo "[INFO] $(_ "Asking whether to install Piper")"
    selected=$(kdialog --title "$(_ "Piper TTS")" --combobox "$(_ "Install Piper TTS?")" "$NO_LABEL" "$YES_LABEL")
    ret=$?
    if [ $ret -ne 0 ]; then
        abort_install
    fi
    if [ "$selected" == "$YES_LABEL" ]; then
        echo "yes" > "$TRADUIA_PIPER_FILE"
    else
        echo "no" > "$TRADUIA_PIPER_FILE"
    fi
    chown root:root "$TRADUIA_PIPER_FILE" 2>/dev/null || true
}

prepare_apt_env() {
    local src tmp
    src="$(cat "$TRADUIA_SOURCE_FILE" 2>/dev/null || echo internet)"
    cleanup_apt_env
    if [ "$src" = "internet" ] || [ -z "$src" ]; then
        return 0
    fi
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/traduia-apt.XXXXXX")" || return 1
    mkdir -p "$tmp/etc/apt/sources.list.d" \
             "$tmp/etc/apt/preferences.d" \
             "$tmp/lists/partial" \
             "$tmp/cache/archives/partial" \
             "$tmp/log"
    cp -a /etc/apt/sources.list "$tmp/etc/apt/sources.list" 2>/dev/null || :
    if [ -d /etc/apt/sources.list.d ]; then
        cp -a /etc/apt/sources.list.d/. "$tmp/etc/apt/sources.list.d/" 2>/dev/null || :
    fi
    if [[ "$src" == http://* || "$src" == https://* ]]; then
        printf 'deb [trusted=yes] %s/debs/%s ./\n' "${src%/}" "$CODENAME" > "$tmp/etc/apt/sources.list.d/99-traduia-offline.list"
    else
        printf 'deb [trusted=yes] file:%s/debs/%s ./\n' "${src%/}" "$CODENAME" > "$tmp/etc/apt/sources.list.d/99-traduia-offline.list"
    fi
    echo "$tmp" > "$TRADUIA_APT_ENV"
    chown root:root "$TRADUIA_APT_ENV" 2>/dev/null || true
    if ! run_apt update >/dev/null 2>&1; then
        cleanup_apt_env
        return 1
    fi
    return 0
}

cleanup_apt_env() {
    local d
    if [ -f "$TRADUIA_APT_ENV" ]; then
        d="$(cat "$TRADUIA_APT_ENV" 2>/dev/null || true)"
        if [ -n "$d" ] && [ -d "$d" ]; then
            safe_rm_rf "$TMP_BASE" "$d" || rm -rf -- "$d" 2>/dev/null || true
        fi
        safe_rm_f "$TMP_BASE" "$TRADUIA_APT_ENV" || true
    fi
}

run_apt() {
    local d
    if [ -f "$TRADUIA_APT_ENV" ]; then
        d="$(cat "$TRADUIA_APT_ENV" 2>/dev/null || true)"
        if [ -n "$d" ] && [ -d "$d" ]; then
            apt-get \
                -o "Dir::Etc=$d/etc/apt" \
                -o "Dir::Etc::sourcelist=$d/etc/apt/sources.list" \
                -o "Dir::Etc::sourceparts=$d/etc/apt/sources.list.d" \
                -o "Dir::Etc::trusted=/etc/apt/trusted.gpg" \
                -o "Dir::Etc::trustedparts=/etc/apt/trusted.gpg.d" \
                -o "Dir::Etc::main=/etc/apt/apt.conf" \
                -o "Dir::Etc::parts=/etc/apt/apt.conf.d" \
                -o "Dir::Etc::preferences=/etc/apt/preferences" \
                -o "Dir::Etc::preferencesparts=/etc/apt/preferences.d" \
                -o "Dir::State::lists=$d/lists" \
                -o "Dir::Cache=$d/cache" \
                -o "Dir::Log=$d/log" \
                -o "APT::Get::List-Cleanup=0" \
                "$@"
            return $?
        fi
    fi
    apt-get "$@"
}

install_traduia_from_source() {
    echo "$(_ "Installing traduia package")"
    if ! run_apt install -y --reinstall --allow-downgrades traduia; then
        echo "[ERROR] $(_ "Failed to install traduia package")" >&2
        return 1
    fi
    return 0
}

install_piper_all_voices() {
    local piper_state src list tmp_list v
    piper_state="$(cat "$TRADUIA_PIPER_FILE" 2>/dev/null || echo no)"
    [ "$piper_state" = "yes" ] || return 0
    if dpkg-query -W -f='${Status}' piper-tts-server 2>/dev/null | grep -q "install ok installed"; then
        echo "[INFO] $(_ "Piper is already installed; keeping the current voices.")"
        return 0
    fi
    src="$(cat "$TRADUIA_SOURCE_FILE" 2>/dev/null || echo internet)"
    if [ "$src" = "internet" ] || [ -z "$src" ]; then
        echo "$(_ "Installing Piper TTS and all voices...")"
        run_apt install -y piper-tts-server || return 1
        return 0
    fi
    list="$src/debs-$CODENAME.txt"
    tmp_list=""
    if [[ "$src" == http://* || "$src" == https://* ]]; then
        tmp_list="$(mktemp)"
        if ! curl -fsSL --connect-timeout 5 --max-time 10 -o "$tmp_list" "$list" 2>/dev/null; then
            echo "[WARN] $(_ "Could not download the package list from:") $list" >&2
            safe_rm_f "$TMP_BASE" "$tmp_list" || true
            tmp_list=""
        fi
        list="$tmp_list"
    fi
    local voices=()
    if [ -n "$list" ] && [ -r "$list" ]; then
        mapfile -t voices < <(grep '^piper-tts-voices-' "$list" | sed 's/[[:space:]]//g' | sed '/^$/d')
    fi
    echo "$(_ "Installing Piper TTS and all voices...")"
    if ! run_apt install -y --no-install-recommends piper-tts-server; then
        [ -n "$tmp_list" ] && safe_rm_f "$TMP_BASE" "$tmp_list" || true
        return 1
    fi
    for v in "${voices[@]}"; do
        if ! run_apt install -y "$v"; then
            echo "[WARN] $(_ "Could not install voice:") $v" >&2
        fi
    done
    [ -n "$tmp_list" ] && safe_rm_f "$TMP_BASE" "$tmp_list" || true
    return 0
}

# =========================================================
# Operaciones
# =========================================================

do_preinstall() {
    require_root
    case "${CLI_MODE:-}" in
        ""|Client|Server) ;;
        *) echo "[ERROR] $(_ "Invalid mode:") $CLI_MODE" >&2; return 1 ;;
    esac
    case "${CLI_PIPER:-}" in
        ""|yes|no) ;;
        *) echo "[ERROR] $(_ "Invalid Piper value:") $CLI_PIPER" >&2; return 1 ;;
    esac
    [ -n "${CLI_MODE:-}" ] && echo "$CLI_MODE" > "$TRADUIA_MODE_FILE"
    [ -n "${CLI_SOURCE:-}" ] && echo "$CLI_SOURCE" > "$TRADUIA_SOURCE_FILE"
    [ -n "${CLI_PIPER:-}" ] && echo "$CLI_PIPER" > "$TRADUIA_PIPER_FILE"

    ask_mode
    if [ ! -f "$TRADUIA_SOURCE_FILE" ]; then
        ask_install_source
    elif [ -n "${CLI_SOURCE:-}" ] && [ "$CLI_SOURCE" != "internet" ]; then
        if ! valid_install_repo_dir "$CLI_SOURCE" && ! valid_install_repo_url "$CLI_SOURCE"; then
            echo "[ERROR] $(_ "The repository is not valid:") $CLI_SOURCE" >&2
            return 1
        fi
    fi
    if [ ! -f "$TRADUIA_PIPER_FILE" ]; then
        ask_piper
    fi
    if [ "$mode" == "Server" ] && [ ! -f "$TRADUIA_OPTIMIZE_FILE" ]; then
        ask_optimization
    fi
    if ! prepare_apt_env; then
        echo "[ERROR] $(_ "Could not prepare the package source.")" >&2
        return 1
    fi
    return 0
}

do_postinstall() {
    require_root
    local models_failed=false
    mode=$(cat "$TRADUIA_MODE_FILE" 2>/dev/null)

    install_piper_all_voices || echo "[WARN] $(_ "Could not install Piper TTS or all its voices; continuing.")" >&2

    if [ "$mode" == "Client" ] && ! dpkg-query -W -f='${Status}' piper-tts-server 2>/dev/null | grep -q "install ok installed"; then
        echo "[WARN] $(_ "Client mode: piper-tts-server is not installed; TTS may not work.")" >&2
    fi

    # ==== Exclusivo del modo Server: modelos + escritorio ====
    if [ -n "$mode" ] && [ "$mode" == "Server" ]; then
        if [ ! -x /usr/sbin/install-models-traduia ]; then
            echo "[WARN] $(_ "install-models-traduia not found; skipping model installation")" >&2
            models_failed=true
        else
            echo "$(_ "Downloading models...")"
            # Origen: sin marcador (instalación previa) => Internet.
            if [ -f "$TRADUIA_SOURCE_FILE" ]; then
                MODELS_SOURCE=$(cat "$TRADUIA_SOURCE_FILE")
                chown root:root "$TRADUIA_SOURCE_FILE"
            else
                MODELS_SOURCE="internet"
            fi
            if [ -f "$TRADUIA_OPTIMIZE_FILE" ] && grep -q "optimized" "$TRADUIA_OPTIMIZE_FILE"; then
                OPTIMIZED="optimized"
            else
                OPTIMIZED=""
            fi
            local models_rc=0
            if [ "$MODELS_SOURCE" == "internet" ]; then
                if [ -n "$OPTIMIZED" ]; then
                    /usr/sbin/install-models-traduia install optimized || models_rc=$?
                else
                    /usr/sbin/install-models-traduia install || models_rc=$?
                fi
            else
                if [ -n "$OPTIMIZED" ]; then
                    /usr/sbin/install-models-traduia --from "$MODELS_SOURCE" optimized || models_rc=$?
                else
                    /usr/sbin/install-models-traduia --from "$MODELS_SOURCE" || models_rc=$?
                fi
            fi
            if [ "$models_rc" -ne 0 ]; then
                echo "[ERROR] Model installation failed (exit $models_rc). See the details above and in /var/log/traduia-install.log" >&2
                zero_center_set set-non-configured zero-lliurex-traduia
                return 1
            fi
        fi
        echo "$(_ "Setting server desktop")"
        sed -i -e 's|noDisplay=true|NoDisplay=false|i' /usr/share/applications/traduia-server.desktop
        mkdir -p /opt/ai/traduia
        printf 'Server\n' > "$TRADUIA_MODE_FLAG"
    fi

    # ==== Exclusivo del modo Client: marcador y escritorio ====
    if [ -n "$mode" ] && [ "$mode" == "Client" ]; then
        mkdir -p /opt/ai/traduia
        printf 'Client\n' > "$TRADUIA_MODE_FLAG"
        if [ -f /usr/share/applications/traduia-server.desktop ]; then
            sed -i -e 's|NoDisplay=false|NoDisplay=true|i' /usr/share/applications/traduia-server.desktop
        fi
    fi

    # ==== Entradas web: común a Client y Server ====
    # La comprobación de metas y la tarjeta de lliurex-firefox-settings se
    # configuran en ambos modos; la entrada Ainur (lliurex-www) solo en
    # Server (en un cliente no hay página /srv que la muestre).
    if [ -n "$mode" ] && { [ "$mode" == "Client" ] || [ "$mode" == "Server" ]; }; then
        if check_metas_for_www_entries; then
            echo "[INFO] $(_ "Configuring lliurex-firefox-settings entry")"
            configure_llxffoxsettings
            if [ "$mode" == "Server" ]; then
                if check_www_package; then
                    echo "[INFO] $(_ "Configuring Ainur (lliurex-www) entry")"
                    create_www_entry
                else
                    echo "[INFO] $(_ "Skipping Ainur entry: lliurex-www not installed")"
                fi
            fi
        fi
    fi
    # Los marcadores se consumen siempre.
    cleanup_apt_env || true
    safe_rm_f "$TMP_BASE" "$TRADUIA_MODE_FILE" "$TRADUIA_OPTIMIZE_FILE" "$TRADUIA_SOURCE_FILE" "$TRADUIA_PIPER_FILE" "$TRADUIA_APT_ENV" || true

    # Estado de zero-center: instalación completada. El retorno no es
    # crítico para el resultado de la instalación.
    if [ "$models_failed" = "true" ]; then
        zero_center_set set-non-configured zero-lliurex-traduia
    else
        zero_center_set set-configured zero-lliurex-traduia
    fi
}

do_install() {
    require_root
    do_preinstall || exit 1
    install_traduia_from_source || { cleanup_apt_env || true; exit 1; }
    do_postinstall
}

do_install_package() {
    require_root
    install_traduia_from_source
}

do_configure() {
    require_root
    if [ -n "${CLI_MODE:-}" ]; then echo "$CLI_MODE" > "$TRADUIA_MODE_FILE"; fi
    if [ -n "${CLI_SOURCE:-}" ]; then echo "$CLI_SOURCE" > "$TRADUIA_SOURCE_FILE"; fi
    if [ -n "${CLI_PIPER:-}" ]; then echo "$CLI_PIPER" > "$TRADUIA_PIPER_FILE"; fi
    if [ ! -f "$TRADUIA_MODE_FILE" ] || [ ! -f "$TRADUIA_SOURCE_FILE" ]; then
        echo "[ERROR] $(_ "configure requires --mode and --source.")" >&2
        return 1
    fi
    prepare_apt_env || true
    do_postinstall
}

do_remove() {
    require_root
    REMOVE_PIPER=false
    if dpkg-query -W -f='${Status}' piper-tts-server 2>/dev/null | grep -q "install ok installed"; then
        KEEP_LABEL=$(_ "Keep")
        DELETE_LABEL=$(_ "Delete")
        echo "[INFO] $(_ "Asking remove Piper")"
        selected=$(kdialog --title "$(_ "Remove Piper TTS?")" --combobox "$(_ "Do you want to remove Piper TTS and its voices?")" "$KEEP_LABEL" "$DELETE_LABEL")
        ret=$?
        if [ $ret -eq 0 ] && [ "$selected" == "$DELETE_LABEL" ]; then
            REMOVE_PIPER=true
        fi
    fi
    cleanup_apt_env || true
    safe_rm_f "$TMP_BASE" "$TRADUIA_MODE_FILE" "$TRADUIA_SOURCE_FILE" "$TRADUIA_OPTIMIZE_FILE" "$TRADUIA_PIPER_FILE" "$TRADUIA_APT_ENV" || true
    safe_rm_f "$TRADUIA_DATA_BASE" "$TRADUIA_MODE_FLAG" || true

    # Solo se pregunta sobre los modelos si existen en disco.
    REMOVE_MODELS=false
    if [ -d /opt/ai/traduia/models ] && [ -n "$(ls -A /opt/ai/traduia/models)" ]; then
        KEEP_LABEL=$(_ "Keep")
        DELETE_LABEL=$(_ "Delete")
        echo "[INFO] $(_ "Asking remove models")"
        selected=$(kdialog --title "$(_ "Remove models?")" --combobox "$(_ "Do you want to delete the downloaded models?")" "$KEEP_LABEL" "$DELETE_LABEL")
        ret=$?
        if [ $ret -eq 0 ] && [ "$selected" == "$DELETE_LABEL" ]; then
            REMOVE_MODELS=true
        fi
    fi

    echo "$(_ "Removing traduia package")"
    apt-get remove -y traduia
    TEST=$( dpkg-query -s  traduia 2> /dev/null| grep Status | cut -d " " -f 4 )
    if [ "$TEST" == 'installed' ];then
        # La desinstalación falló, pero las entradas se limpian igualmente.
        echo "[INFO] $(_ "Removing lliurex-firefox-settings entry")"
        remove_llxffoxsettings_conf
        if check_www_package; then
            echo "[INFO] $(_ "Removing Ainur (lliurex-www) entry")"
            remove_www_entry
        fi
        echo "[ERROR] $(_ "Failed to remove traduia package")" >&2
        exit 1
    else
        if [ "$REMOVE_MODELS" = "true" ]; then
            remove_models
        fi
        # El venv (regenerable) y el código se limpian siempre.
        remove_venv
        remove_execcode
        echo "[INFO] $(_ "Removing lliurex-firefox-settings entry")"
        remove_llxffoxsettings_conf
        if check_www_package; then
            echo "[INFO] $(_ "Removing Ainur (lliurex-www) entry")"
            remove_www_entry
        fi
        # Estado de zero-center: paquete eliminado. El retorno no es crítico.
        zero_center_set set-non-configured zero-lliurex-traduia
    fi

    if [ "$REMOVE_PIPER" = "true" ]; then
        local voices
        voices="$(dpkg-query -W -f='${Package} ${Status}\n' 'piper-tts-voices-*' 2>/dev/null | awk '$0 ~ /install ok installed/ {print $1}')"
        echo "$(_ "Removing Piper TTS and voices...")"
        apt-get remove -y piper-tts-server $voices || true
    fi
}

do_status() {
    echo "== $(_ "lliurex-firefox-settings entry:")"
    if [ -f "$TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" ]; then
        if cards_extract_json "$TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" \
            | jq -e '.cards[] | select(.title == "Traduia" or .url == "http://server:8000")' >/dev/null 2>&1; then
            echo "$(_ "Traduia card present:")"
            cards_extract_json "$TRADUIA_LLXFFOXSETTINGS_CARDS_FILE" \
                | jq '.cards[] | select(.title == "Traduia" or .url == "http://server:8000")'
        else
            echo "$(_ "Traduia card not present")"
        fi
    else
        echo "$(_ "cards.js not found:") $TRADUIA_LLXFFOXSETTINGS_CARDS_FILE"
    fi

    echo "== $(_ "Ainur (lliurex-www) entry:")"
    if [ -f "$TRADUIA_WWW_ENTRY_FILE" ]; then
        echo "$(_ "Entry present:") $TRADUIA_WWW_ENTRY_FILE"
        cat "$TRADUIA_WWW_ENTRY_FILE"
    else
        echo "$(_ "Entry not present:") $TRADUIA_WWW_ENTRY_FILE"
    fi
}

do_validate() {
    local src="$1"
    if [ -z "$src" ]; then
        echo "[ERROR] $(_ "validate requires a directory or URL")" >&2
        exit 1
    fi
    case "$src" in
        http://*|https://*)
            # La validación por URL descarga el manifest: requiere root.
            require_root
            if valid_repo_url "$src"; then
                echo "[INFO] $(_ "Valid models repository:") $src"
                return 0
            fi
            ;;
        *)
            if valid_repo_dir "$src"; then
                echo "[INFO] $(_ "Valid models repository:") $src"
                return 0
            fi
            ;;
    esac
    echo "[ERROR] $(_ "The models repository is not valid:") $src" >&2
    return 1
}

interactive_main() {
    require_root
    DETECTED=false
    if dpkg -s traduia 2>/dev/null | grep -q '^Status: install ok installed'; then
        DETECTED=true
        echo "[INFO] $(_ "TraduIA package detected")"
    else
        echo "[INFO] $(_ "TraduIA package not detected")"
    fi

    INSTALL_LABEL=$(_ "Install")
    REMOVE_LABEL=$(_ "Remove")
    echo "[INFO] $(_ "Asking operation")"
    if $DETECTED; then
        selected=$(kdialog --title "$(_ "TraduIA configuration")" --combobox "$(_ "What do you want to do?")" "$INSTALL_LABEL" "$REMOVE_LABEL")
    else
        selected=$(kdialog --title "$(_ "TraduIA configuration")" --combobox "$(_ "What do you want to do?")" "$INSTALL_LABEL")
    fi
    ret=$?
    if [ $ret -ne 0 ]; then
        abort_install
    fi
    echo "[INFO] $(_ "Operation selected:") $selected"

    if [ "$selected" == "$INSTALL_LABEL" ]; then
        do_install
    elif [ "$selected" == "$REMOVE_LABEL" ]; then
        do_remove
    else
        echo "[ERROR] $(_ "Unknown operation:") $selected" >&2
        exit 1
    fi
}

show_help() {
    echo "$(_ "Usage: traduia-config [command] [--disable-meta-checks]")"
    echo ""
    echo "$(_ "  (no parameters)  interactive: detects the traduia package and offers")"
    echo "$(_ "                    Install or Remove (only Install if not installed)")"
    echo "$(_ "  install           preinstall + install traduia + postinstall")"
    echo "$(_ "  install-package   install traduia using the prepared source")"
    echo "$(_ "  configure         configure mode/source/Piper after packages are installed")"
    echo "$(_ "  remove            ask about models/Piper + apt-get remove + cleanup")"
    echo "$(_ "  preinstall        Q&A (mode/source/Piper/optimization) + markers")"
    echo "$(_ "  postinstall       Piper/models + web entries (zero-center)")"
    echo "$(_ "  status            web entries status")"
    echo "$(_ "  validate <dir|url>  quick models repository validation")"
    echo "$(_ "  --mode <Client|Server>  installation mode")"
    echo "$(_ "  --source <internet|path|url>  packages and models source")"
    echo "$(_ "  --piper / --no-piper   install Piper TTS or not")"
    echo "$(_ "  --disable-meta-checks  skip the LliureX metas check (web entries)")"
    echo "$(_ "  help              this help")"
}

# =========================================================
# Punto de entrada
# =========================================================
# Opción global --disable-meta-checks: aceptada antes o después del
# comando; equivale a TRADUIA_SKIP_METAS_CHECK=1 (omite la comprobación
# de metas y fuerza la configuración de las entradas web de Firefox; la
# entrada Ainur sigue limitada al modo Server).
ARGS=()
ORIG_ARGS=("$@")
META_SKIP_CLI=false
CLI_MODE=""
CLI_SOURCE=""
CLI_PIPER=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --disable-meta-checks)
            META_SKIP_CLI=true
            shift
            ;;
        --mode)
            if [ "$#" -lt 2 ]; then
                echo "[ERROR] $(_ "Option requires a value:") --mode <Client|Server>" >&2
                exit 1
            fi
            CLI_MODE="$2"
            shift 2
            ;;
        --mode=*)
            CLI_MODE="${1#*=}"
            shift
            ;;
        --source)
            if [ "$#" -lt 2 ]; then
                echo "[ERROR] $(_ "Option requires a value:") --source <internet|path|url>" >&2
                exit 1
            fi
            CLI_SOURCE="$2"
            shift 2
            ;;
        --source=*)
            CLI_SOURCE="${1#*=}"
            shift
            ;;
        --piper)
            CLI_PIPER="yes"
            shift
            ;;
        --no-piper)
            CLI_PIPER="no"
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done
case "${CLI_MODE:-}" in
    ""|Client|Server) ;;
    *) echo "[ERROR] $(_ "Invalid mode:") $CLI_MODE" >&2; exit 1 ;;
esac
case "${CLI_PIPER:-}" in
    ""|yes|no) ;;
    *) echo "[ERROR] $(_ "Invalid Piper value:") $CLI_PIPER" >&2; exit 1 ;;
esac
if [ "$META_SKIP_CLI" = "true" ]; then
    TRADUIA_SKIP_METAS_CHECK=1
    echo "[INFO] $(_ "LliureX metas check disabled (--disable-meta-checks)")"
fi

# =========================================================
# Logging integral a /var/log/traduia-install.log (en común con
# install-models-traduia). Todo el stdout/stderr va a consola y
# al fichero; si el fichero no es escribible (p. ej. sin root)
# se continúa sin teeing. Literal en inglés: no pasa por i18n.
# =========================================================
TRADUIA_CONFIG_LOG="${TRADUIA_CONFIG_LOG:-/var/log/traduia-install.log}"
if touch "$TRADUIA_CONFIG_LOG" 2>/dev/null; then
    printf 'Starting traduia-config (%s) at %s\n' \
        "${ORIG_ARGS[*]}" "$(date '+%d/%m/%Y %H:%M:%S')" >>"$TRADUIA_CONFIG_LOG"
    exec > >(tee -a "$TRADUIA_CONFIG_LOG") 2>&1
    # install-models-traduia (hijo) no debe tee-ear también: la salida
    # del hijo ya queda capturada por este tee (evita doble escritura).
    export TRADUIA_CONFIG_LOGGING=1
fi

case "${ARGS[0]:-}" in
    "")            interactive_main ;;
    install)       do_install ;;
    install-package) do_install_package ;;
    configure)     do_configure ;;
    remove)        do_remove ;;
    preinstall)    do_preinstall ;;
    postinstall)   do_postinstall ;;
    status)        do_status ;;
    validate)      do_validate "${ARGS[1]:-}" ;;
    help|-h|--help) show_help ;;
    *)             show_help; exit 1 ;;
esac
