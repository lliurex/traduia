import os, json, subprocess, shutil, tempfile
from huggingface_hub import snapshot_download, model_info
from huggingface_hub.utils import disable_progress_bars, RepositoryNotFoundError
disable_progress_bars()

HF_HOME = os.environ.get("HF_HOME", "/opt/ai/traduia/models")
CT2_BASE = os.path.join(HF_HOME, "ct2")

MARIAN_PAIRS = [
    "es-en", "es-fr", "es-de", "es-ru", "es-ar",
    "es-uk", "es-ro", "es-it", "ca-en", "ca-es",
]

TOKENIZER_FILES = [
    "tokenizer_config.json",
    "vocab.json",
    "source.spm",
    "target.spm",
    "special_tokens_map.json",
    "tokenizer.json",
]


def _has_ct2_model(out_dir):
    model_bin = os.path.join(out_dir, "model.bin")
    if os.path.exists(model_bin) and os.path.getsize(model_bin) > 0:
        return True
    if os.path.isdir(os.path.join(out_dir, "model")):
        return True
    return False


for pair in MARIAN_PAIRS:
    out_dir = os.path.join(CT2_BASE, f"opus-mt-{pair}")

    if _has_ct2_model(out_dir):
        print(f"[CT2] opus-mt-{pair} already available, skipping.")
        continue

    # === Primary: download pre-converted from mijuanlo ===
    # Repo: mijuanlo/opus-mt-{pair}-ct2-int8
    # To force original method: comment this block, uncomment fallback block below
    try:
        repo = f"mijuanlo/opus-mt-{pair}-ct2-int8"
        model_info(repo)
        print(f"[CT2] Downloading pre-converted: {repo} -> {out_dir}")
        snapshot_download(repo_id=repo, local_dir=out_dir)
        print(f"[CT2] Done: opus-mt-{pair}")
        continue
    except (RepositoryNotFoundError, Exception):
        print(f"[CT2] mijuanlo pre-converted not available for {pair}, falling back to conversion.")

    # === Fallback: download from Helsinki-NLP and convert ===
    model_id = f"Helsinki-NLP/opus-mt-{pair}"
    os.makedirs(out_dir, exist_ok=True)

    print(f"[CT2] Converting {model_id} ...")
    subprocess.run([
        "ct2-transformers-converter",
        "--model", model_id,
        "--output_dir", out_dir,
        "--quantization", "int8",
        "--force",
    ], check=True)

    temp_dir = tempfile.mkdtemp(prefix=f"marian-{pair}-")
    try:
        snapshot_download(repo_id=model_id, local_dir=temp_dir)

        for fname in TOKENIZER_FILES:
            src = os.path.join(temp_dir, fname)
            if not os.path.exists(src):
                continue
            dst = os.path.join(out_dir, fname)
            if os.path.exists(dst):
                if fname.endswith(".json"):
                    with open(src, encoding="utf-8") as f_src, \
                         open(dst, encoding="utf-8") as f_dst:
                        src_data = json.load(f_src)
                        dst_data = json.load(f_dst)
                    merged = {**src_data, **dst_data}
                    with open(dst, "w", encoding="utf-8") as f_out:
                        json.dump(merged, f_out, indent=2, ensure_ascii=False)
                    print(f"[CT2]   Merged {fname}")
                else:
                    print(f"[CT2]   Skipped {fname} (CT2 already has it)")
            else:
                shutil.copy2(src, dst)
                print(f"[CT2]   Copied {fname}")

        hf_config = os.path.join(temp_dir, "config.json")
        ct2_config = os.path.join(out_dir, "config.json")
        if os.path.exists(hf_config) and os.path.exists(ct2_config):
            with open(hf_config, encoding="utf-8") as f_src, \
                 open(ct2_config, encoding="utf-8") as f_dst:
                hf_data = json.load(f_src)
                ct2_data = json.load(f_dst)
            merged = {**hf_data, **ct2_data}
            with open(ct2_config, "w", encoding="utf-8") as f_out:
                json.dump(merged, f_out, indent=2, ensure_ascii=False)
            print(f"[CT2]   Merged config.json")
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

    # --- ORIGINAL CODE (commented for reference - uncomment to restore) ---
