#!/usr/bin/env bash
set -euo pipefail

export TEXTDOMAIN="traduia"
export TEXTDOMAINDIR="/usr/share/locale"

_() {
    gettext "$1"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_VER=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}');")
cd "$SCRIPT_DIR"

SHARED_HF="/usr/lib/ai/traduia_models"
TRADUIA_DIR="/usr/lib/traduia"
TRADUIA_VENV="$TRADUIA_DIR/venv"

mkdir -p "$SHARED_HF"/{hub,transformers,datasets} || true

echo "[setup] $(_ "Creating venv") $TRADUIA_VENV"
python3 -m venv $TRADUIA_VENV > /dev/null 2>&1

echo "[setup] $(_ "Activating venv")"
echo $TRADUIA_DIR > $TRADUIA_VENV/lib/python${PYTHON_VER}/site-packages/extra_paths.pth
source $TRADUIA_VENV/bin/activate

echo "[setup] $(_ "Updating pip/setuptools/wheel")"
python -m pip install --upgrade pip setuptools wheel  > /dev/null 2>&1

echo "[setup] $(_ "Installing Python dependencies")"
pip install fastapi uvicorn[standard] python-multipart numpy sounddevice faster-whisper transformers sentencepiece huggingface_hub ctranslate2 psutil > /dev/null 2>&1

echo "[setup] $(_ "Exporting shared cache variables (for this process)")"
export HF_HOME="$SHARED_HF"
export HF_HUB_CACHE="$SHARED_HF/hub"
export TRANSFORMERS_CACHE="$SHARED_HF/transformers"
export HF_DATASETS_CACHE="$SHARED_HF/datasets"
export ALICIA_MODEL_CACHE="$SHARED_HF/hub"

# Durante la precarga NO ponemos offline=1 (si falta algo, debe descargar).
unset HF_HUB_OFFLINE || true
unset TRANSFORMERS_OFFLINE || true

function download_inet_models(){
    echo "[setup] $(_ "Preloading models into shared cache...")"
    python - <<'PY'
import os
from huggingface_hub import snapshot_download
from huggingface_hub.utils import disable_progress_bars
disable_progress_bars()

print("[preload] HF_HOME:", os.environ.get("HF_HOME"))
print("[preload] HF_HUB_CACHE:", os.environ.get("HF_HUB_CACHE"))

# faster-whisper small => repo
repos = [
    "Systran/faster-whisper-small",

    # MarianMT (Helsinki-NLP) - ajusta esta lista si usas otros pares
    "Helsinki-NLP/opus-mt-es-en",
    "Helsinki-NLP/opus-mt-es-fr",
    "Helsinki-NLP/opus-mt-es-de",
    "Helsinki-NLP/opus-mt-es-ru",
    "Helsinki-NLP/opus-mt-es-ar",
    "Helsinki-NLP/opus-mt-es-ro",
    "Helsinki-NLP/opus-mt-es-uk",
    "Helsinki-NLP/opus-mt-ca-en",
    "Helsinki-NLP/opus-mt-ca-es",
]

for repo in repos:
    print(f"[preload] Downloading/caching: {repo}")
    snapshot_download(
        repo_id=repo,
        cache_dir=os.environ.get("HF_HUB_CACHE"),
        local_dir=None,
    )

print("[preload] OK. Models cached.")
PY
}

URL_BASE="http://server:4141/traduia_models"
LOCALDIR="/usr/lib/ai/traduia_models"

function download_lan_models(){
    mkdir -p "$LOCALDIR"
    echo "[setup] $(_ "Getting structure and downloading files from LAN...")"

    curl -sSL "$URL_BASE" | python3 -c '
import sys, json, os, urllib.request

base_url = sys.argv[1].rstrip("/")
local_base = sys.argv[2]

try:
    data = json.load(sys.stdin)
except json.JSONDecodeError:
    print("Error: Could not parse JSON. Check server response.", file=sys.stderr)
    sys.exit(1)

for item in data:
    rel_path = item["path"].lstrip("/")
    local_path = os.path.join(local_base, rel_path)

    if item["type"] == "dir":
        os.makedirs(local_path, exist_ok=True)
        print(f"[ DIR ] Created: {local_path}")

    elif item["type"] == "file":
        os.makedirs(os.path.dirname(local_path), exist_ok=True)

        remote_url = f"{base_url}/{rel_path}"

        print(f"[FILE ] Downloading: {remote_url}")
        try:
            urllib.request.urlretrieve(remote_url, local_path)
        except Exception as e:
            print(f"[ERROR] Failed to download {remote_url}: {e}", file=sys.stderr)
' "$URL_BASE" "$LOCALDIR"

    echo "[setup] $(_ "LAN download finished.")"
}

check_code=$(check-traduia-server 2>&1 >/dev/null)
if echo $check_code|grep -q http &>/dev/null;then
    has_http_available=0
else
    has_http_available=1
fi

echo "$(_ "Downloading models")"
if [ $has_http_available -eq 0 ]; then
    download_lan_models
else
    download_inet_models
fi
echo "$(_ "Models downloaded!")"

checked_size=$(du -ms "$SHARED_HF" |awk '{print $1}')

if [ -n "$checked_size" -a "$checked_size" -gt 5000 ]; then
    sed -ri 's|NoDisplay=true|NoDisplay=false|g' /usr/share/applications/traduia.desktop
fi

echo "$(_ "Downloading torch")"
pip install --index-url https://download.pytorch.org/whl/cpu torch > /dev/null 2>&1
pip install sacremoses  > /dev/null 2>&1
echo "$(_ "Torch downloaded!")"

echo ""
echo "[setup] $(_ "Ready.")"
echo ""
echo "$(_ "Offline execution (the launcher already exports it):")"
echo "  HF_HUB_OFFLINE=1"
echo "  TRANSFORMERS_OFFLINE=1"
