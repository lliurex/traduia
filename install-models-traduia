#!/usr/bin/env bash
set -euo pipefail

export TEXTDOMAIN="traduia"
export TEXTDOMAINDIR="/usr/share/locale"

_() {
    gettext -- "$1"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_VER=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}');")
cd "$SCRIPT_DIR"

SHARED_HF="${TRADUIA_MODELS_DIR:-/opt/ai/traduia/models}"
TRADUIA_DIR="/usr/lib/traduia"
TRADUIA_VENV="/opt/ai/traduia/venv"
CONFIG_FILE="/etc/traduia/models-repo.conf"

MARIAN_PAIRS=(
    "es-en" "es-fr" "es-de" "es-ru" "es-ar"
    "es-uk" "es-ro" "es-it" "ca-en" "ca-es"
)

# =========================================================
# Argumentos
# =========================================================
USE_CT2=false
CLI_URL=""
DETECT_ONLY=false

while [ $# -gt 0 ]; do
    case "$1" in
        optimized)
            USE_CT2=true
            shift
            ;;
        --url)
            if [ $# -lt 2 ]; then
                echo "[ERROR] $(_ "--url requires a value: --url http://host/path")" >&2
                exit 1
            fi
            CLI_URL="$2"
            shift 2
            ;;
        --url=*)
            CLI_URL="${1#--url=}"
            shift
            ;;
        --dir)
            if [ $# -lt 2 ]; then
                echo "[ERROR] $(_ "--dir requires a value: --dir /path/to/models/repo")" >&2
                exit 1
            fi
            CLI_DIR="$2"
            shift 2
            ;;
        --dir=*)
            CLI_DIR="${1#--dir=}"
            shift
            ;;
        --from)
            if [ $# -lt 2 ]; then
                echo "[ERROR] $(_ "--from requires a value: --from <url|path>")" >&2
                exit 1
            fi
            CLI_FROM="$2"
            shift 2
            ;;
        --from=*)
            CLI_FROM="${1#--from=}"
            shift
            ;;
        --detect)
            DETECT_ONLY=true
            shift
            ;;
        *)
            echo "[ERROR] $(_ "Unknown argument:") $1" >&2
            exit 1
            ;;
    esac
done

# --url, --dir y --from son mutuamente excluyentes
SOURCE_OPTS=0
[ -n "${CLI_URL:-}" ] && SOURCE_OPTS=$((SOURCE_OPTS + 1))
[ -n "${CLI_DIR:-}" ] && SOURCE_OPTS=$((SOURCE_OPTS + 1))
[ -n "${CLI_FROM:-}" ] && SOURCE_OPTS=$((SOURCE_OPTS + 1))
if [ "$SOURCE_OPTS" -gt 1 ]; then
    echo "[ERROR] $(_ "Options --url, --dir and --from are mutually exclusive.")" >&2
    exit 1
fi

# --from: autodetección url vs ruta local
if [ -n "${CLI_FROM:-}" ]; then
    case "$CLI_FROM" in
        http://*|https://*)
            CLI_URL="$CLI_FROM"
            ;;
        file://*)
            CLI_DIR="${CLI_FROM#file://}"
            ;;
        *)
            CLI_DIR="$CLI_FROM"
            ;;
    esac
fi

if [ -n "${CLI_DIR:-}" ] && [ ! -d "$CLI_DIR" ]; then
    echo "[ERROR] $(_ "Source directory does not exist:") $CLI_DIR" >&2
    exit 1
fi

# =========================================================
# Configuración: /etc/traduia/models-repo.conf
# Formato: TRADUIA_MODELS_URL=http://servidor:puerto/public/models/traduia
# Prioridad de URL: CLI > variable de entorno > fichero de config
# =========================================================
if [ -z "${TRADUIA_MODELS_URL:-}" ] && [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

MODELS_URL="${CLI_URL:-${TRADUIA_MODELS_URL:-}}"
MODELS_DIR="${CLI_DIR:-}"

# =========================================================
# Detección de modelos ya presentes en disco
# =========================================================
MISSING_FILES=()
DETECT_TMP="$(mktemp)"
trap 'rm -f "$DETECT_TMP"' EXIT

detect_local_models() {
    local whisper_ok=false
    local ct2_ok=true
    local marian_ok=true
    local any=false

    if [ -s "$SHARED_HF/whisper-small/model.bin" ] && [ -s "$SHARED_HF/whisper-small/config.json" ]; then
        whisper_ok=true
    fi

    for pair in "${MARIAN_PAIRS[@]}"; do
        if [ ! -s "$SHARED_HF/ct2/opus-mt-$pair/model.bin" ]; then
            ct2_ok=false
        fi
        if [ ! -s "$SHARED_HF/marian/opus-mt-$pair/pytorch_model.bin" ]; then
            marian_ok=false
        fi
    done

    for d in whisper-small ct2 marian; do
        if [ -d "$SHARED_HF/$d" ] && [ -n "$(ls -A "$SHARED_HF/$d" 2>/dev/null)" ]; then
            any=true
        fi
    done

    printf 'whisper_ok=%s\nct2_ok=%s\nmarian_ok=%s\n' "$whisper_ok" "$ct2_ok" "$marian_ok" > "$DETECT_TMP"

    if $whisper_ok && $ct2_ok && $marian_ok; then
        echo "complete:both"
    elif $whisper_ok && $ct2_ok; then
        echo "complete:ct2"
    elif $whisper_ok && $marian_ok; then
        echo "complete:marian"
    elif $any; then
        echo "partial"
    else
        echo "none"
    fi
}

DETECT_STATE="$(detect_local_models)"
# shellcheck disable=SC1090
. "$DETECT_TMP"

# =========================================================
# Modo --detect (utilidad de depuración; el zero-center ya
# siempre pregunta y la descarga decide por-set)
# =========================================================
if [ "$DETECT_ONLY" = "true" ]; then
    echo "$DETECT_STATE"
    exit 0
fi

# =========================================================
# Marcador del modo efectivo (ct2 => .use_ct2, marian => .use_marian)
# =========================================================
set_mode_marker() {
    if [ "$USE_CT2" = "true" ]; then
        touch "$SHARED_HF/.use_ct2"
        rm -f "$SHARED_HF/.use_marian"
    else
        touch "$SHARED_HF/.use_marian"
        rm -f "$SHARED_HF/.use_ct2"
    fi
}

mkdir -p "$SHARED_HF"/{hub,transformers,datasets} || true

echo "[setup] $(_ "Creating venv") $TRADUIA_VENV"
python3 -m venv $TRADUIA_VENV > /dev/null 2>&1

echo "[setup] $(_ "Activating venv")"
echo $TRADUIA_DIR > $TRADUIA_VENV/lib/python${PYTHON_VER}/site-packages/extra_paths.pth
source $TRADUIA_VENV/bin/activate

echo "[setup] $(_ "Updating pip/setuptools/wheel")"
python -m pip install --no-cache-dir --upgrade pip setuptools wheel  > /dev/null 2>&1

echo "[setup] $(_ "Installing Python dependencies")"
if [ "$USE_CT2" = "true" ]; then
    pip install --no-cache-dir fastapi uvicorn[standard] python-multipart numpy sounddevice faster-whisper transformers sentencepiece huggingface_hub ctranslate2 psutil > /dev/null 2>&1
else
    pip install --no-cache-dir fastapi uvicorn[standard] python-multipart numpy sounddevice faster-whisper transformers sentencepiece huggingface_hub psutil > /dev/null 2>&1
fi

echo "[setup] $(_ "Exporting shared cache variables (for this process)")"
export HF_HOME="$SHARED_HF"
export HF_HUB_CACHE="$SHARED_HF/hub"
export TRANSFORMERS_CACHE="$SHARED_HF/transformers"
export HF_DATASETS_CACHE="$SHARED_HF/datasets"
export ALICIA_MODEL_CACHE="$SHARED_HF/hub"

# Durante la precarga NO ponemos offline=1 (si falta algo, debe descargar).
unset HF_HUB_OFFLINE || true
unset TRANSFORMERS_OFFLINE || true

function download_inet_models(){
    echo "[setup] $(_ "Preloading models into shared cache...")"
    export USE_CT2_MODE="$USE_CT2"
    python - <<'PY'
import os
from huggingface_hub import snapshot_download, model_info
from huggingface_hub.utils import disable_progress_bars, RepositoryNotFoundError
disable_progress_bars()

print("[preload] HF_HOME:", os.environ.get("HF_HOME"))
print("[preload] HF_HUB_CACHE:", os.environ.get("HF_HUB_CACHE"))

# === WHISPER MODEL ===
# Primary: mijuanlo/whisper-small-ct2-int8
# Fallback: Systran/faster-whisper-small
# To force original method: comment mijuanlo block, uncomment Systran block below

WHISPER_LOCAL = os.environ.get("TRADUIA_MODELS_DIR", "/opt/ai/traduia/models") + "/whisper-small"
_whisper_repo = None
try:
    model_info("mijuanlo/whisper-small-ct2-int8")
    _whisper_repo = "mijuanlo/whisper-small-ct2-int8"
    print(f"[preload] Using whisper from: {_whisper_repo}")
except (RepositoryNotFoundError, Exception):
    _whisper_repo = "Systran/faster-whisper-small"
    print(f"[preload] mijuanlo whisper not available, fallback to: {_whisper_repo}")

print(f"[preload] Downloading: {_whisper_repo} -> {WHISPER_LOCAL}")
snapshot_download(repo_id=_whisper_repo, local_dir=WHISPER_LOCAL)

# === MARIANMT MODELS (only when not using CTranslate2) ===
# Primary: mijuanlo/opus-mt-{pair}
# Fallback: Helsinki-NLP/opus-mt-{pair}

use_ct2 = os.environ.get("USE_CT2_MODE", "false").strip().lower() == "true"
if not use_ct2:
    marian_pairs = [
        "es-en", "es-fr", "es-de", "es-ru", "es-ar",
        "es-uk", "es-ro", "es-it", "ca-en", "ca-es",
    ]
    marian_base = os.environ.get("TRADUIA_MODELS_DIR", "/opt/ai/traduia/models") + "/marian"
    for pair in marian_pairs:
        local = f"{marian_base}/opus-mt-{pair}"
        try:
            repo = f"mijuanlo/opus-mt-{pair}"
            model_info(repo)
            print(f"[preload] Downloading: {repo} -> {local}")
            snapshot_download(repo_id=repo, local_dir=local)
        except (RepositoryNotFoundError, Exception):
            repo = f"Helsinki-NLP/opus-mt-{pair}"
            print(f"[preload] Fallback: {repo} -> {local}")
            snapshot_download(repo_id=repo, local_dir=local)

print("[preload] OK. Models cached.")
PY
}

function download_http_models(){
    local base_url="$1"
    local mode="$2"
    echo "[setup] $(_ "Downloading models from HTTP repository:") $base_url"
    echo "[setup] $(_ "Fetching manifest:") $base_url/manifest.json"

    local tmp_manifest
    tmp_manifest="$(mktemp)"
    if ! curl -fsSL --connect-timeout 15 -o "$tmp_manifest" "$base_url/manifest.json"; then
        rm -f "$tmp_manifest"
        echo "[ERROR] $(_ "Could not fetch manifest.json from:") $base_url/manifest.json" >&2
        echo "[ERROR] $(_ "Check TRADUIA_MODELS_URL or /etc/traduia/models-repo.conf")" >&2
        exit 1
    fi

    python3 - "$tmp_manifest" "$base_url" "$SHARED_HF" "$mode" <<'PY'
import hashlib
import json
import os
import subprocess
import sys

manifest_path, base_url, local_base, mode = sys.argv[1], sys.argv[2].rstrip("/"), sys.argv[3], sys.argv[4]

MARIAN_PAIRS = [
    "es-en", "es-fr", "es-de", "es-ru", "es-ar",
    "es-uk", "es-ro", "es-it", "ca-en", "ca-es",
]
WHISPER_FILES = ["model.bin", "config.json"]
CT2_MANDATORY_FILES = ["model.bin", "config.json", "source.spm", "target.spm"]
MARIAN_REQUIRED_FILES = ["pytorch_model.bin", "config.json", "source.spm", "target.spm", "vocab.json"]

try:
    with open(manifest_path, encoding="utf-8") as fh:
        manifest = json.load(fh)
except (json.JSONDecodeError, OSError) as e:
    print(f"[ERROR] Invalid manifest.json: {e}", file=sys.stderr)
    sys.exit(1)

files = manifest.get("files", [])
if not files:
    print("[ERROR] manifest.json contains no files.", file=sys.stderr)
    sys.exit(1)

print(f"[manifest] version={manifest.get('version')} mode={manifest.get('mode')} files={len(files)}")

# --- Validación de completitud del set pedido (antes de descargar) ---
required_files = [f"whisper-small/{x}" for x in WHISPER_FILES]
if mode == "ct2":
    for pair in MARIAN_PAIRS:
        for x in CT2_MANDATORY_FILES:
            required_files.append(f"ct2/opus-mt-{pair}/{x}")
else:
    for pair in MARIAN_PAIRS:
        for x in MARIAN_REQUIRED_FILES:
            required_files.append(f"marian/opus-mt-{pair}/{x}")

manifest_paths = {f["path"] for f in files}
missing = [p for p in required_files if p not in manifest_paths]

# Vocabulario ct2: vocabulary.txt (conversión local) o vocab.json (pre-convertido)
if mode == "ct2":
    for pair in MARIAN_PAIRS:
        base = f"ct2/opus-mt-{pair}"
        if f"{base}/vocabulary.txt" not in manifest_paths and f"{base}/vocab.json" not in manifest_paths:
            missing.append(f"{base}/vocabulary.txt o vocab.json")

if missing:
    print(f"[ERROR] Repository does not contain the complete '{mode}' model set. Missing:", file=sys.stderr)
    for m in missing:
        print(f"  - {m}", file=sys.stderr)
    print("[ERROR] Publish the set with traduia-make-repo or fix TRADUIA_MODELS_URL.", file=sys.stderr)
    sys.exit(1)

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

def wanted(rel):
    return rel.startswith("whisper-small/") or rel.startswith(f"{mode}/")

for entry in files:
    rel = entry["path"]
    if not wanted(rel):
        print(f"[SKIP ] {rel} (not in mode {mode})")
        continue
    size = entry.get("size")
    sha = entry.get("sha256")
    local = os.path.join(local_base, rel)
    os.makedirs(os.path.dirname(local), exist_ok=True)

    # Si el fichero ya está completo y verificado, no se descarga.
    if os.path.exists(local) and size is not None and os.path.getsize(local) == size:
        if sha and sha256_file(local) == sha:
            print(f"[SKIP ] {rel} (already present and verified)")
            continue
        if not sha:
            print(f"[SKIP ] {rel} (already present, size OK)")
            continue

    url = f"{base_url}/{rel}"
    print(f"[FILE ] {rel}")

    # Intento con reanudación; si falla, descarga completa.
    rc = subprocess.run(
        ["curl", "-fSL", "-C", "-", "--connect-timeout", "15", "-o", local, url]
    ).returncode
    if rc != 0:
        subprocess.run(["rm", "-f", local])
        rc = subprocess.run(
            ["curl", "-fSL", "--connect-timeout", "15", "-o", local, url]
        ).returncode
    if rc != 0:
        print(f"[ERROR] Failed to download {url}", file=sys.stderr)
        sys.exit(1)

    if size is not None and os.path.getsize(local) != size:
        print(f"[ERROR] Size mismatch for {rel}: expected {size}, got {os.path.getsize(local)}", file=sys.stderr)
        sys.exit(1)

    if sha and sha256_file(local) != sha:
        print(f"[ERROR] SHA256 mismatch for {rel}", file=sys.stderr)
        print("[ERROR] The repository may be corrupted or served by a stale proxy cache.", file=sys.stderr)
        sys.exit(1)

print("[download] OK. All files downloaded and verified.")
PY

    rm -f "$tmp_manifest"
    echo "[setup] $(_ "HTTP download finished.")"
}

function copy_from_dir(){
    local src_dir="$1"
    local mode="$2"
    echo "[setup] $(_ "Copying models from local directory:") $src_dir"
    python3 - "$src_dir" "$SHARED_HF" "$mode" <<'PY'
import hashlib
import json
import os
import shutil
import sys

src_dir, local_base, mode = sys.argv[1].rstrip("/"), sys.argv[2], sys.argv[3]

MARIAN_PAIRS = [
    "es-en", "es-fr", "es-de", "es-ru", "es-ar",
    "es-uk", "es-ro", "es-it", "ca-en", "ca-es",
]
WHISPER_FILES = ["model.bin", "config.json"]
CT2_MANDATORY_FILES = ["model.bin", "config.json", "source.spm", "target.spm"]
MARIAN_REQUIRED_FILES = ["pytorch_model.bin", "config.json", "source.spm", "target.spm", "vocab.json"]

manifest_path = os.path.join(src_dir, "manifest.json")
if not os.path.exists(manifest_path):
    print(f"[ERROR] No manifest.json found in source directory: {src_dir}", file=sys.stderr)
    sys.exit(1)

try:
    with open(manifest_path, encoding="utf-8") as fh:
        manifest = json.load(fh)
except (json.JSONDecodeError, OSError) as e:
    print(f"[ERROR] Invalid manifest.json: {e}", file=sys.stderr)
    sys.exit(1)

files = manifest.get("files", [])
if not files:
    print("[ERROR] manifest.json contains no files.", file=sys.stderr)
    sys.exit(1)

# --- Validación de completitud del set pedido (igual que el cliente HTTP) ---
required = [f"whisper-small/{x}" for x in WHISPER_FILES]
if mode == "ct2":
    for pair in MARIAN_PAIRS:
        for x in CT2_MANDATORY_FILES:
            required.append(f"ct2/opus-mt-{pair}/{x}")
else:
    for pair in MARIAN_PAIRS:
        for x in MARIAN_REQUIRED_FILES:
            required.append(f"marian/opus-mt-{pair}/{x}")

manifest_paths = {f["path"] for f in files}
missing = [p for p in required if p not in manifest_paths]
if mode == "ct2":
    for pair in MARIAN_PAIRS:
        base = f"ct2/opus-mt-{pair}"
        if f"{base}/vocabulary.txt" not in manifest_paths and f"{base}/vocab.json" not in manifest_paths:
            missing.append(f"{base}/vocabulary.txt o vocab.json")

if missing:
    print(f"[ERROR] Source directory does not contain the complete '{mode}' model set. Missing:", file=sys.stderr)
    for m in missing:
        print(f"  - {m}", file=sys.stderr)
    if mode == "ct2":
        print("[ERROR] Use 'optimized' or point to a source that contains the ct2 set.", file=sys.stderr)
    else:
        print("[ERROR] Run without 'optimized' or point to a source that contains the marian set.", file=sys.stderr)
    sys.exit(1)

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

def wanted(rel):
    return rel.startswith("whisper-small/") or rel.startswith(f"{mode}/")

copied = 0
skipped = 0
for entry in files:
    rel = entry["path"]
    if not wanted(rel):
        continue
    size = entry.get("size")
    sha = entry.get("sha256")
    src = os.path.join(src_dir, rel)
    dst = os.path.join(local_base, rel)
    if not os.path.exists(src):
        print(f"[ERROR] File listed in manifest but missing in source: {rel}", file=sys.stderr)
        sys.exit(1)
    # Si el fichero ya está completo y verificado en el destino, no se copia.
    if os.path.exists(dst) and size is not None and os.path.getsize(dst) == size:
        if sha and sha256_file(dst) == sha:
            print(f"[SKIP ] {rel} (already present and verified)")
            skipped += 1
            continue
        if not sha:
            print(f"[SKIP ] {rel} (already present, size OK)")
            skipped += 1
            continue
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copy2(src, dst)
    print(f"[COPY ] {rel}")
    copied += 1

print(f"[ok] {copied} copied, {skipped} skipped")
PY
    echo "[setup] $(_ "Local copy finished.")"
}

# =========================================================
# Descarga de modelos (por-set: skip solo si el set pedido
# ya está completo en disco; si no, se descarga/completa)
# =========================================================
echo "$(_ "Downloading models")"
export USE_CT2_MODE="$USE_CT2"

if [ "$USE_CT2" = "true" ]; then
    REQUESTED_SET="ct2"
    REQUESTED_SET_OK="$ct2_ok"
else
    REQUESTED_SET="marian"
    REQUESTED_SET_OK="$marian_ok"
fi

if [ "$whisper_ok" = "true" ] && [ "$REQUESTED_SET_OK" = "true" ]; then
    echo "[setup] $(_ "{} models already present on disk. Skipping downloads.")" | sed "s|{}|$REQUESTED_SET|"
else
    if [ "$REQUESTED_SET_OK" != "true" ]; then
        echo "[setup] $(_ "{} models incomplete on disk; completing download.")" | sed "s|{}|$REQUESTED_SET|"
    fi
    if [ -n "$MODELS_DIR" ]; then
        copy_from_dir "$MODELS_DIR" "$REQUESTED_SET"
    elif [ -n "$MODELS_URL" ]; then
        download_http_models "$MODELS_URL" "$REQUESTED_SET"
    else
        download_inet_models
    fi
fi
echo "$(_ "Models downloaded!")"

checked_size=$(du -ms "$SHARED_HF" |awk '{print $1}')

if [ -n "$checked_size" -a "$checked_size" -gt 5000 ]; then
    sed -ri 's|NoDisplay=true|NoDisplay=false|g' /usr/share/applications/traduia.desktop
fi

if python -c "import torch" 2>/dev/null; then
    echo "[setup] $(_ "Torch already installed, skipping.")"
else
    echo "$(_ "Downloading torch")"
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch > /dev/null 2>&1
    echo "$(_ "Torch downloaded!")"
fi
pip install --no-cache-dir sacremoses  > /dev/null 2>&1

if [ "$USE_CT2" = "true" ]; then
    echo "[setup] $(_ "Downloading/Converting Marian models to CTranslate2...")"
    mkdir -p "$SHARED_HF/ct2"

    python - <<'PY'
import os, json, subprocess, shutil, tempfile
from huggingface_hub import snapshot_download, model_info
from huggingface_hub.utils import disable_progress_bars, RepositoryNotFoundError
disable_progress_bars()

HF_HOME = os.environ.get("HF_HOME", "/opt/ai/traduia/models")
CT2_BASE = os.path.join(HF_HOME, "ct2")

MARIAN_PAIRS = [
    "es-en", "es-fr", "es-de", "es-ru", "es-ar",
    "es-uk", "es-ro", "es-it", "ca-en", "ca-es",
]

TOKENIZER_FILES = [
    "tokenizer_config.json",
    "vocab.json",
    "source.spm",
    "target.spm",
    "special_tokens_map.json",
    "tokenizer.json",
]


def _has_ct2_model(out_dir):
    model_bin = os.path.join(out_dir, "model.bin")
    if os.path.exists(model_bin) and os.path.getsize(model_bin) > 0:
        return True
    if os.path.isdir(os.path.join(out_dir, "model")):
        return True
    return False


for pair in MARIAN_PAIRS:
    out_dir = os.path.join(CT2_BASE, f"opus-mt-{pair}")

    if _has_ct2_model(out_dir):
        print(f"[CT2] opus-mt-{pair} already available, skipping.")
        continue

    # === Primary: download pre-converted from mijuanlo ===
    # Repo: mijuanlo/opus-mt-{pair}-ct2-int8
    # To force original method: comment this block, uncomment fallback block below
    try:
        repo = f"mijuanlo/opus-mt-{pair}-ct2-int8"
        model_info(repo)
        print(f"[CT2] Downloading pre-converted: {repo} -> {out_dir}")
        snapshot_download(repo_id=repo, local_dir=out_dir)
        print(f"[CT2] Done: opus-mt-{pair}")
        continue
    except (RepositoryNotFoundError, Exception):
        print(f"[CT2] mijuanlo pre-converted not available for {pair}, falling back to conversion.")

    # === Fallback: download from Helsinki-NLP and convert ===
    model_id = f"Helsinki-NLP/opus-mt-{pair}"
    os.makedirs(out_dir, exist_ok=True)

    print(f"[CT2] Converting {model_id} ...")
    subprocess.run([
        "ct2-transformers-converter",
        "--model", model_id,
        "--output_dir", out_dir,
        "--quantization", "int8",
        "--force",
    ], check=True)

    temp_dir = tempfile.mkdtemp(prefix=f"marian-{pair}-")
    try:
        snapshot_download(repo_id=model_id, local_dir=temp_dir)

        for fname in TOKENIZER_FILES:
            src = os.path.join(temp_dir, fname)
            if not os.path.exists(src):
                continue
            dst = os.path.join(out_dir, fname)
            if os.path.exists(dst):
                if fname.endswith(".json"):
                    with open(src, encoding="utf-8") as f_src, \
                         open(dst, encoding="utf-8") as f_dst:
                        src_data = json.load(f_src)
                        dst_data = json.load(f_dst)
                    merged = {**src_data, **dst_data}
                    with open(dst, "w", encoding="utf-8") as f_out:
                        json.dump(merged, f_out, indent=2, ensure_ascii=False)
                    print(f"[CT2]   Merged {fname}")
                else:
                    print(f"[CT2]   Skipped {fname} (CT2 already has it)")
            else:
                shutil.copy2(src, dst)
                print(f"[CT2]   Copied {fname}")

        hf_config = os.path.join(temp_dir, "config.json")
        ct2_config = os.path.join(out_dir, "config.json")
        if os.path.exists(hf_config) and os.path.exists(ct2_config):
            with open(hf_config, encoding="utf-8") as f_src, \
                 open(ct2_config, encoding="utf-8") as f_dst:
                hf_data = json.load(f_src)
                ct2_data = json.load(f_dst)
            merged = {**hf_data, **ct2_data}
            with open(ct2_config, "w", encoding="utf-8") as f_out:
                json.dump(merged, f_out, indent=2, ensure_ascii=False)
            print(f"[CT2]   Merged config.json")
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

print("[CT2] All Marian models ready.")
PY
fi

